{{!--
  Template: skill-index.json
  Input: an object with these fields:
    generatedAt   — ISO 8601 timestamp
    categories    — array of category objects, each containing:
      id          — category identifier (e.g., "cms")
      label       — human-readable label (e.g., "Headless CMS")
      description — short category description
      entities    — array of entity objects, each containing:
        name      — entity name, title case (e.g., "Entry")
        skills    — array of skill objects, each containing:
          name        — kebab-case skill name
          type        — "EventHandler" or "UseCase"
          description — short skill description

  This file is the internal data store. The MCP server reads it and
  serializes to markdown when responding to list_webiny_skills calls.
  It is NEVER returned directly to agents as JSON.

  MCP response serialization rules:

  Tier 1 (no category param):
    # Webiny Skills
    ## {id} ({label}) — {count} skills
    {description}

  Tier 2 (with category param):
    # {Label} Skills
    ## {EntityName}
    - **{skill.name}** ({skill.type}) — {skill.description}
--}}
{
  "generatedAt": "{{generatedAt}}",
  "categories": [
    {{#each categories}}
    {
      "id": "{{this.id}}",
      "label": "{{this.label}}",
      "description": "{{this.description}}",
      "entities": [
        {{#each this.entities}}
        {
          "name": "{{this.name}}",
          "skills": [
            {{#each this.skills}}
            {
              "name": "{{this.name}}",
              "type": "{{this.type}}",
              "description": "{{this.description}}"
            }{{#unless @last}},{{/unless}}
            {{/each}}
          ]
        }{{#unless @last}},{{/unless}}
        {{/each}}
      ]
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ]
}
