{{!--
  Template: skill.manifest.json
  Input: an object with these fields:
    skillName          — kebab-case skill name
    generated          — boolean (true for auto-generated, false for hand-authored)
    generatedAt        — ISO 8601 timestamp
    generatedFromRef   — git commit hash of the source repo at generation time (git rev-parse HEAD)
    abstractionType    — "EventHandler" or "UseCase"
    className          — exported class name
    importPath         — webiny import path
    sources            — array of { package, files } objects
    typeHash           — SHA-256 hash of the extracted type block

  For hand-authored skills, only these fields are used:
    skillName, generated (false), lastReviewedAt, relatedPackages
--}}
{{#if generated}}
{
  "skill": "{{skillName}}",
  "generated": true,
  "generatedAt": "{{generatedAt}}",
  "generatedFromRef": "{{generatedFromRef}}",
  "abstractionType": "{{abstractionType}}",
  "className": "{{className}}",
  "importPath": "{{importPath}}",
  "sources": [
    {{#each sources}}
    {
      "package": "{{this.package}}",
      "files": [
        {{#each this.files}}
        "{{this}}"{{#unless @last}},{{/unless}}
        {{/each}}
      ]
    }{{#unless @last}},{{/unless}}
    {{/each}}
  ],
  "typeHash": "{{typeHash}}"
}
{{else}}
{
  "skill": "{{skillName}}",
  "generated": false,
  "lastReviewedAt": "{{lastReviewedAt}}",
  "relatedPackages": [
    {{#each relatedPackages}}
    "{{this}}"{{#unless @last}},{{/unless}}
    {{/each}}
  ]
}
{{/if}}
