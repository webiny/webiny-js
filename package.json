    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@grpc/grpc-js": "^1.14.3",
    "@lexical/code": "^0.41.0",
    "@lexical/hashtag": "^0.41.0",
    "@lexical/headless": "^0.41.0",
    "@lexical/history": "^0.41.0",
