{
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "migrations",
      "nextjs",
      "cypress-tests",
      "extensions/theme",
      "scripts/buildPackages",
      "scripts/prepublishOnly",
      "scripts/cli",
      "scripts/cjsToEsm"
    ]
  },
  "author": "Webiny Ltd.",
  "repository": {
    "type": "git",
    "url": "https://github.com/webiny/webiny-js.git"
  },
  "devDependencies": {
