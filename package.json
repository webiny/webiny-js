{
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "packages/*",
      "nextjs",
      "cypress-tests",
      "extensions/theme",
      "scripts/buildPackages",
      "scripts/prepublishOnly",
      "scripts/cli",
      "scripts/cjsToEsm",
      "scripts/generateSkills"
    ]
  },
  "author": "Webiny Ltd.",
  "repository": {
    "type": "git",
    "url": "https://github.com/webiny/webiny-js.git"
  },
  "devDependencies": {
    "@babel/code-frame": "^7.29.0",
    "@babel/compat-data": "^7.29.3",
    "@babel/core": "^7.29.0",
    "@babel/helper-define-polyfill-provider": "^0.6.8",
    "@babel/helper-environment-visitor": "^7.24.7",
    "@babel/parser": "^7.29.3",
    "@babel/plugin-proposal-throw-expressions": "^7.27.1",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@babel/register": "^7.29.3",
    "@babel/runtime": "^7.29.2",
    "@babel/template": "^7.28.6",
    "@babel/traverse": "^7.29.0",
    "@babel/types": "^7.29.0",
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@grpc/grpc-js": "^1.14.3",
    "@lexical/code": "^0.44.0",
    "@lexical/hashtag": "^0.44.0",
    "@lexical/headless": "^0.44.0",
    "@lexical/history": "^0.44.0",
    "@lexical/html": "^0.44.0",
    "@lexical/list": "^0.44.0",
    "@lexical/mark": "^0.44.0",
    "@lexical/overflow": "^0.44.0",
    "@lexical/react": "^0.44.0",
    "@lexical/rich-text": "^0.44.0",
    "@lexical/selection": "^0.44.0",
    "@lexical/text": "^0.44.0",
    "@lexical/utils": "^0.44.0",
    "@octokit/rest": "^20.1.2",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^24.12.2",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "@vitest/coverage-v8": "^4.1.5",
    "adio": "^3.0.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-macros": "^3.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "chalk": "^5.6.2",
    "cross-env": "^10.1.0",
    "deepmerge": "^4.3.1",
    "execa": "^5.1.1",
    "fast-glob": "^3.3.3",
    "folder-hash": "^4.1.2",
    "fs-extra": "^11.3.4",
    "get-yarn-workspaces": "^1.0.2",
    "github-actions-wac": "^2.0.0",
    "graphql": "^16.13.2",
    "husky": "^9.1.7",
    "inquirer": "^13.4.2",
    "jest-extended": "^7.0.0",
    "lerna": "8.1.2",
    "lexical": "^0.44.0",
    "load-json-file": "^7.0.1",
    "lodash": "^4.18.1",
    "minimatch": "^10.2.5",
    "nanoid": "^5.1.11",
    "next": "^16.2.4",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "semver": "^7.7.4",
    "ts-expect": "^1.3.0",
    "tsx": "^4.21.0",
    "type-fest": "^5.6.0",
    "typescript": "6.0.3",
    "validator": "^13.15.35",
    "verdaccio": "^6.5.2",
    "vitest": "^4.1.5",
    "write-json-file": "^7.0.0",
    "yargs": "^18.0.0"
  },
  "optionalDependencies": {
    "fsevents": "^2.3.3"
  },
  "scripts": {
    "add-webiny-package": "node scripts/addWebinyPackage.js",
    "awp": "yarn add-webiny-package",
    "build": "tsx scripts/buildPackages",
    "build:api": "yarn webiny ws run build --scope='@webiny/api*' --scope='@webiny/handler*'",
    "build:apps": "yarn webiny ws run build --scope='@webiny/app*'",
    "build:full": "yarn build --build-overrides='{\"tsConfig\":{\"compilerOptions\":{\"skipLibCheck\":false}}}'",
    "check-package-dependencies": "node scripts/checkPackageNodeModules.js",
    "check-ts-configs": "node scripts/checkTsConfigs.js",
    "ci-workflows:build": "yarn ghawac build",
    "ci-workflows:watch": "yarn ghawac watch",
    "clear-all": "yarn clear-dist && yarn clear-webiny-build-cache && yarn clear-node-modules && yarn clear-empty-package-folders --no-preview",
    "clear-dist": "rm -rf packages/*/dist",
    "clear-empty-package-folders": "node scripts/deleteEmptyPackageFolders.js",
    "clear-node-modules": "rm -rf node_modules",
    "clear-webiny-build-cache": "rm -rf .webiny/cached-packages",
    "cy:open": "yarn cypress:open",
    "cy:run": "yarn cypress:run",
    "cy:setup": "yarn setup-cypress",
    "cy:ts": "yarn cypress:ts",
    "cypress:open": "cd cypress-tests && yarn cypress open",
    "cypress:run": "cd cypress-tests && yarn cypress run",
    "cypress:ts": "cd cypress-tests && yarn tsc --noEmit",
    "deploy": "yarn webiny deploy",
    "dispatch-github-event": "node ./scripts/dispatchGitHubEvent.js",
    "format": "oxfmt",
    "format:fix": "oxfmt",
    "format:check": "oxfmt --check",
    "link-workspaces": "node ./scripts/linkWorkspaces.js",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "mdx-from-folder": "tsx scripts/mdxFromFolder",
    "open": "yarn webiny open",
    "postinstall": "yarn node ./scripts/linkWorkspaces.js",
    "prepublishOnly": "tsx scripts/prepublishOnly/src/index.ts",
    "release": "tsx ./scripts/release/src/index.ts",
    "setup-cypress": "tsx scripts/setupCypress",
    "setup-env-files": "node scripts/setupEnvFiles",
    "setup-project": "node scripts/setupProject",
    "system:build": "yarn && yarn ghawac build && yarn webiny sync-dependencies && yarn build",
    "system:verify": "yarn lint && yarn format:check && yarn adio && yarn check-ts-configs && yarn webiny verify-dependencies",
    "test": "vitest --config testing/vitest.config.ts --run",
    "test:ddb": "WEBINY_STORAGE=ddb vitest --config testing/vitest.config.ts --run",
    "test:es": "WEBINY_STORAGE=ddb-es,ddb vitest --config testing/vitest.config.ts --run",
    "test:os": "WEBINY_STORAGE=ddb-os,ddb vitest --config testing/vitest.config.ts --run",
    "trigger-release": "node ./scripts/release/triggerRelease.js",
    "tsc": "tsc",
    "update-packages": "tsx ./scripts/updatePackages.ts",
    "validate-packages": "node scripts/validatePackages.js",
    "verdaccio:start": "yarn verdaccio -c ./.verdaccio.yaml",
    "verify-dependencies": "yarn webiny verify-dependencies",
    "watch": "yarn webiny watch",
    "watch:api": "yarn webiny ws run watch --scope='@webiny/api*'",
    "watch:apps": "yarn webiny ws run watch --scope='@webiny/app*'",
    "wby": "./node_modules/.bin/wby",
    "webiny": "./node_modules/.bin/webiny",
    "webiny-mcp": "./node_modules/.bin/webiny-mcp",
    "webiny-admin-build-storybook": "cd packages/admin-ui && cross-env OUT=../../netlify-static yarn build-storybook",
    "webiny-admin-import-from-figma": "node packages/admin-ui/scripts/importFromFigma.js",
    "webiny-admin-storybook": "cd packages/admin-ui && yarn storybook",
    "webiny-admin-storybook-docs": "cd packages/admin-ui && yarn storybook-docs",
    "webiny-scripts": "tsx ./scripts/cli/src/bin.ts",
    "webiny-versions": "node ./scripts/webinyVersions.js",
    "generate-skills": "tsx ./scripts/generateSkills/src/bin.ts"
  },
  "yargs": {
    "populate--": true
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "feat",
          "fix",
          "docs",
          "style",
          "refactor",
          "test",
          "build",
          "ci",
          "chore",
          "revert",
          "merge",
          "wip"
        ]
      ]
    }
  },
  "lerna": {
    "version": "0.0.0",
    "packages": [
      "packages/*"
    ]
  },
  "resolutions": {
    "lerna/minimatch": "^3.1.3",
    "@types/react": "18.3.28",
    "handlebars": "4.7.9",
    "@types/react-dom": "18.3.7",
    "lodash": "4.18.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lerna@8.1.2": "patch:lerna@npm%3A8.1.2#./.yarn/patches/lerna-npm-8.1.2-be48ad2329.patch",
    "apollo-link@^1.2.14": "patch:apollo-link@npm%3A1.2.14#./.yarn/patches/apollo-link-npm-1.2.14-74f0ba01f9.patch",
    "apollo-link@^1.0.0": "patch:apollo-link@npm%3A1.2.14#./.yarn/patches/apollo-link-npm-1.2.14-74f0ba01f9.patch"
  },
  "packageManager": "yarn@4.14.1",
  "dependencies": {
    "@types/hoist-non-react-statics": "^3.3.7",
    "@webiny/di": "^0.2.3",
    "jwt-decode": "^4.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
