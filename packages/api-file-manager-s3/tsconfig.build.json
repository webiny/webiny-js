{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api/tsconfig.build.json" },
    { "path": "../api-core/tsconfig.build.json" },
    { "path": "../api-file-manager/tsconfig.build.json" },
    { "path": "../api-graphql/tsconfig.build.json" },
    { "path": "../api-websockets/tsconfig.build.json" },
    { "path": "../aws-sdk/tsconfig.build.json" },
    { "path": "../background-tasks/tsconfig.build.json" },
    { "path": "../feature/tsconfig.build.json" },
    { "path": "../handler/tsconfig.build.json" },
    { "path": "../kernel-aws/tsconfig.build.json" },
    { "path": "../kernel-core/tsconfig.build.json" },
    { "path": "../plugins/tsconfig.build.json" },
    { "path": "../validation/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api/*": ["../api/src/*"],
      "@webiny/api": ["../api/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-file-manager/*": ["../api-file-manager/src/*"],
      "@webiny/api-file-manager": ["../api-file-manager/src"],
      "@webiny/api-graphql/*": ["../api-graphql/src/*"],
      "@webiny/api-graphql": ["../api-graphql/src"],
      "@webiny/api-websockets/*": ["../api-websockets/src/*"],
      "@webiny/api-websockets": ["../api-websockets/src"],
      "@webiny/aws-sdk/*": ["../aws-sdk/src/*"],
      "@webiny/aws-sdk": ["../aws-sdk/src"],
      "@webiny/background-tasks/*": ["../background-tasks/src/*"],
      "@webiny/background-tasks": ["../background-tasks/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/kernel-aws/*": ["../kernel-aws/src/*"],
      "@webiny/kernel-aws": ["../kernel-aws/src"],
      "@webiny/kernel-core/*": ["../kernel-core/src/*"],
      "@webiny/kernel-core": ["../kernel-core/src"],
      "@webiny/plugins/*": ["../plugins/src/*"],
      "@webiny/plugins": ["../plugins/src"],
      "@webiny/validation/*": ["../validation/src/*"],
      "@webiny/validation": ["../validation/src"]
    }
  }
}
