    "@webiny/feature": "0.0.0",
    "@webiny/project": "0.0.0",
    "@webiny/project-extensions": "0.0.0",
    "@webiny/project-extensions-aws": "0.0.0",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
