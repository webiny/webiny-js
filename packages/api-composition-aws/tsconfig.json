{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-composition-core" },
    { "path": "../api-core" },
    { "path": "../api-file-manager-s3" },
    { "path": "../api-graphql" },
    { "path": "../api-headless-cms-bulk-actions-aws" },
    { "path": "../api-kernel-aws" },
    { "path": "../api-kernel-core" },
    { "path": "../api-scheduler" },
    { "path": "../api-scheduler-aws" },
    { "path": "../api-websockets-aws" },
    { "path": "../aws-sdk" },
    { "path": "../background-tasks-aws" },
    { "path": "../feature" },
    { "path": "../handler" },
    { "path": "../utils" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-composition-core/*": ["../api-composition-core/src/*"],
      "@webiny/api-composition-core": ["../api-composition-core/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-file-manager-s3/*": ["../api-file-manager-s3/src/*"],
      "@webiny/api-file-manager-s3": ["../api-file-manager-s3/src"],
      "@webiny/api-graphql/*": ["../api-graphql/src/*"],
      "@webiny/api-graphql": ["../api-graphql/src"],
      "@webiny/api-headless-cms-bulk-actions-aws/*": ["../api-headless-cms-bulk-actions-aws/src/*"],
      "@webiny/api-headless-cms-bulk-actions-aws": ["../api-headless-cms-bulk-actions-aws/src"],
      "@webiny/api-kernel-aws/*": ["../api-kernel-aws/src/*"],
      "@webiny/api-kernel-aws": ["../api-kernel-aws/src"],
      "@webiny/api-kernel-core/*": ["../api-kernel-core/src/*"],
      "@webiny/api-kernel-core": ["../api-kernel-core/src"],
      "@webiny/api-scheduler/*": ["../api-scheduler/src/*"],
      "@webiny/api-scheduler": ["../api-scheduler/src"],
      "@webiny/api-scheduler-aws/*": ["../api-scheduler-aws/src/*"],
      "@webiny/api-scheduler-aws": ["../api-scheduler-aws/src"],
      "@webiny/api-websockets-aws/*": ["../api-websockets-aws/src/*"],
      "@webiny/api-websockets-aws": ["../api-websockets-aws/src"],
      "@webiny/aws-sdk/*": ["../aws-sdk/src/*"],
      "@webiny/aws-sdk": ["../aws-sdk/src"],
      "@webiny/background-tasks-aws/*": ["../background-tasks-aws/src/*"],
      "@webiny/background-tasks-aws": ["../background-tasks-aws/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"]
    }
  }
}
