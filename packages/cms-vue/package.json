{
  "name": "@webiny/cms-vue",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/webiny/webiny-js.git"
  },
  "exports": {
    ".": "./index.js",
    "./*": "./*"
  },
  "description": "Vue 3 integration for Webiny CMS SDK.",
  "contributors": [
    "Adrian Smijulj <adrian@webiny.com>"
  ],
  "license": "MIT",
  "dependencies": {
    "@webiny/cms-sdk": "0.0.0",
    "mobx": "^7.0.3"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "devDependencies": {
    "@webiny/build-tools": "0.0.0",
    "happy-dom": "^20.11.6",
    "typescript": "7.0.2",
    "vitest": "^4.1.11",
    "vue": "^3.5.41"
  },
  "adio": {
    "ignore": {
      "dependencies": [
        "@webiny/cms-sdk",
        "mobx"
      ]
    }
  },
  "webiny": {
    "publishFrom": "dist"
  },
  "publishConfig": {
    "access": "public"
  }
}
