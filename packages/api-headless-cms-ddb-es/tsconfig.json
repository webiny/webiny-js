{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api" },
    { "path": "../api-headless-cms" },
    { "path": "../api-headless-cms-utils-os" },
    { "path": "../api-opensearch" },
    { "path": "../api-search-index-tasks" },
    { "path": "../db" },
    { "path": "../db-dynamodb" },
    { "path": "../error" },
    { "path": "../feature" },
    { "path": "../plugins" },
    { "path": "../utils" },
    { "path": "../api-core" },
    { "path": "../api-core-testing" },
    { "path": "../api-graphql" },
    { "path": "../api-search-index-tasks-ddb-os" },
    { "path": "../api-sync-ddb-to-opensearch" },
    { "path": "../background-tasks" },
    { "path": "../event-handler-core" },
    { "path": "../handler" },
    { "path": "../wcp" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api/*": ["../api/src/*"],
      "@webiny/api": ["../api/src"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/api-headless-cms-utils-os/*": ["../api-headless-cms-utils-os/src/*"],
      "@webiny/api-headless-cms-utils-os": ["../api-headless-cms-utils-os/src"],
      "@webiny/api-opensearch/*": ["../api-opensearch/src/*"],
      "@webiny/api-opensearch": ["../api-opensearch/src"],
      "@webiny/api-search-index-tasks/*": ["../api-search-index-tasks/src/*"],
      "@webiny/api-search-index-tasks": ["../api-search-index-tasks/src"],
      "@webiny/db/*": ["../db/src/*"],
      "@webiny/db": ["../db/src"],
      "@webiny/db-dynamodb/*": ["../db-dynamodb/src/*"],
      "@webiny/db-dynamodb": ["../db-dynamodb/src"],
      "@webiny/error/*": ["../error/src/*"],
      "@webiny/error": ["../error/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/plugins/*": ["../plugins/src/*"],
      "@webiny/plugins": ["../plugins/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-core-testing/*": ["../api-core-testing/src/*"],
      "@webiny/api-core-testing": ["../api-core-testing/src"],
      "@webiny/api-graphql/*": ["../api-graphql/src/*"],
      "@webiny/api-graphql": ["../api-graphql/src"],
      "@webiny/api-search-index-tasks-ddb-os/*": ["../api-search-index-tasks-ddb-os/src/*"],
      "@webiny/api-search-index-tasks-ddb-os": ["../api-search-index-tasks-ddb-os/src"],
      "@webiny/api-sync-ddb-to-opensearch/*": ["../api-sync-ddb-to-opensearch/src/*"],
      "@webiny/api-sync-ddb-to-opensearch": ["../api-sync-ddb-to-opensearch/src"],
      "@webiny/background-tasks/*": ["../background-tasks/src/*"],
      "@webiny/background-tasks": ["../background-tasks/src"],
      "@webiny/event-handler-core/*": ["../event-handler-core/src/*"],
      "@webiny/event-handler-core": ["../event-handler-core/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/wcp/*": ["../wcp/src/*"],
      "@webiny/wcp": ["../wcp/src"]
    }
  }
}
