{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../project/tsconfig.build.json" },
    { "path": "../project-aws-extensions/tsconfig.build.json" },
    { "path": "../project-standalone-extensions/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/project/*": ["../project/src/*"],
      "@webiny/project": ["../project/src"],
      "@webiny/project-aws-extensions/*": ["../project-aws-extensions/src/*"],
      "@webiny/project-aws-extensions": ["../project-aws-extensions/src"],
      "@webiny/project-standalone-extensions/*": ["../project-standalone-extensions/src/*"],
      "@webiny/project-standalone-extensions": ["../project-standalone-extensions/src"]
    }
  }
}
