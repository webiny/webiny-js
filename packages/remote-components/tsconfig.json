{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../admin-ui" },
    { "path": "../ai-powerups" },
    { "path": "../api-core" },
    { "path": "../api-file-manager" },
    { "path": "../api-graphql" },
    { "path": "../api-headless-cms" },
    { "path": "../api-websockets" },
    { "path": "../app" },
    { "path": "../app-admin" },
    { "path": "../app-website-builder" },
    { "path": "../app-websockets" },
    { "path": "../feature" },
    { "path": "../project" },
    { "path": "../project-aws" },
    { "path": "../utils" },
    { "path": "../website-builder-sdk" },
    { "path": "../api-core-testing" },
    { "path": "../event-handler-core" },
    { "path": "../handler" },
    { "path": "../sdk-nextjs" },
    { "path": "../wcp" },
    { "path": "../website-builder-nextjs" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/admin-ui/*": ["../admin-ui/src/*"],
      "@webiny/admin-ui": ["../admin-ui/src"],
      "@webiny/ai-powerups/*": ["../ai-powerups/src/*"],
      "@webiny/ai-powerups": ["../ai-powerups/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-file-manager/*": ["../api-file-manager/src/*"],
      "@webiny/api-file-manager": ["../api-file-manager/src"],
      "@webiny/api-graphql/*": ["../api-graphql/src/*"],
      "@webiny/api-graphql": ["../api-graphql/src"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/api-websockets/*": ["../api-websockets/src/*"],
      "@webiny/api-websockets": ["../api-websockets/src"],
      "@webiny/app/*": ["../app/src/*"],
      "@webiny/app": ["../app/src"],
      "@webiny/app-admin/*": ["../app-admin/src/*"],
      "@webiny/app-admin": ["../app-admin/src"],
      "@webiny/app-website-builder/*": ["../app-website-builder/src/*"],
      "@webiny/app-website-builder": ["../app-website-builder/src"],
      "@webiny/app-websockets/*": ["../app-websockets/src/*"],
      "@webiny/app-websockets": ["../app-websockets/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/project/*": ["../project/src/*"],
      "@webiny/project": ["../project/src"],
      "@webiny/project-aws/*": ["../project-aws/src/*"],
      "@webiny/project-aws": ["../project-aws/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"],
      "@webiny/website-builder-sdk/*": ["../website-builder-sdk/src/*"],
      "@webiny/website-builder-sdk": ["../website-builder-sdk/src"],
      "@webiny/api-core-testing/*": ["../api-core-testing/src/*"],
      "@webiny/api-core-testing": ["../api-core-testing/src"],
      "@webiny/event-handler-core/*": ["../event-handler-core/src/*"],
      "@webiny/event-handler-core": ["../event-handler-core/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/sdk-nextjs/*": ["../sdk-nextjs/src/*"],
      "@webiny/sdk-nextjs": ["../sdk-nextjs/src"],
      "@webiny/wcp/*": ["../wcp/src/*"],
      "@webiny/wcp": ["../wcp/src"],
      "@webiny/website-builder-nextjs/*": ["../website-builder-nextjs/src/*"],
      "@webiny/website-builder-nextjs": ["../website-builder-nextjs/src"]
    }
  }
}
