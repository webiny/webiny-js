{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api-component-extraction/tsconfig.build.json" },
    { "path": "../api-core/tsconfig.build.json" },
    { "path": "../api-file-manager/tsconfig.build.json" },
    { "path": "../api-graphql/tsconfig.build.json" },
    { "path": "../api-website-builder/tsconfig.build.json" },
    { "path": "../background-tasks/tsconfig.build.json" },
    { "path": "../feature/tsconfig.build.json" },
    { "path": "../remote-components/tsconfig.build.json" },
    { "path": "../website-builder-sdk/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-component-extraction/*": ["../api-component-extraction/src/*"],
      "@webiny/api-component-extraction": ["../api-component-extraction/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-file-manager/*": ["../api-file-manager/src/*"],
      "@webiny/api-file-manager": ["../api-file-manager/src"],
      "@webiny/api-graphql/*": ["../api-graphql/src/*"],
      "@webiny/api-graphql": ["../api-graphql/src"],
      "@webiny/api-website-builder/*": ["../api-website-builder/src/*"],
      "@webiny/api-website-builder": ["../api-website-builder/src"],
      "@webiny/background-tasks/*": ["../background-tasks/src/*"],
      "@webiny/background-tasks": ["../background-tasks/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/remote-components/*": ["../remote-components/src/*"],
      "@webiny/remote-components": ["../remote-components/src"],
      "@webiny/website-builder-sdk/*": ["../website-builder-sdk/src/*"],
      "@webiny/website-builder-sdk": ["../website-builder-sdk/src"]
    }
  }
}
