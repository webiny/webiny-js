{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api" },
    { "path": "../api-core" },
    { "path": "../api-websockets" },
    { "path": "../feature" },
    { "path": "../kernel-core" },
    { "path": "../kernel-standalone" },
    { "path": "../plugins" },
    { "path": "../utils" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api/*": ["../api/src/*"],
      "@webiny/api": ["../api/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-websockets/*": ["../api-websockets/src/*"],
      "@webiny/api-websockets": ["../api-websockets/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/kernel-core/*": ["../kernel-core/src/*"],
      "@webiny/kernel-core": ["../kernel-core/src"],
      "@webiny/kernel-standalone/*": ["../kernel-standalone/src/*"],
      "@webiny/kernel-standalone": ["../kernel-standalone/src"],
      "@webiny/plugins/*": ["../plugins/src/*"],
      "@webiny/plugins": ["../plugins/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"]
    }
  }
}
