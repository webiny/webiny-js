{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [{ "path": "../lexical-nodes/tsconfig.build.json" }],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/lexical-nodes/*": ["../lexical-nodes/src/*"],
      "@webiny/lexical-nodes": ["../lexical-nodes/src"]
    },
    "baseUrl": "."
  }
}
