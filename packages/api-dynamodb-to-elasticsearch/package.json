  "license": "MIT",
  "author": "Webiny Ltd.",
  "dependencies": {
    "@webiny/api": "0.0.0",
    "@webiny/api-opensearch": "0.0.0",
    "@webiny/aws-sdk": "0.0.0",
    "@webiny/error": "0.0.0",
    "@webiny/event-handler-aws": "0.0.0",
    "@webiny/event-handler-core": "0.0.0",
    "@webiny/feature": "0.0.0",
    "@webiny/handler-aws": "0.0.0",
    "@webiny/utils": "0.0.0",
    "p-retry": "^8.0.0"
  },
  "devDependencies": {
