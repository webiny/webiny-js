{
  "name": "@webiny/db-sqlite",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webiny/webiny-js.git"
  },
  "description": "SQLite database core for Webiny container deployments. Drizzle ORM + better-sqlite3 with a single-table schema mirroring the DynamoDB layout used by *-ddb storage operations.",
  "contributors": [
    "Sven Al Hamad <sven@webiny.com>"
  ],
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "drizzle-orm": "^0.36.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@webiny/build-tools": "0.0.0",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.5"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
