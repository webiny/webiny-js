{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api" },
    { "path": "../api-aco" },
    { "path": "../api-audit-logs" },
    { "path": "../api-core" },
    { "path": "../api-file-manager" },
    { "path": "../api-headless-cms" },
    { "path": "../api-headless-cms-aco" },
    { "path": "../api-headless-cms-tasks" },
    { "path": "../api-mailer" },
    { "path": "../api-opensearch" },
    { "path": "../api-record-locking" },
    { "path": "../api-website-builder" },
    { "path": "../api-websockets" },
    { "path": "../aws-sdk" },
    { "path": "../background-tasks" },
    { "path": "../error" },
    { "path": "../handler" },
    { "path": "../handler-aws" },
    { "path": "../handler-graphql" },
    { "path": "../plugins" },
    { "path": "../wcp" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api/*": ["../api/src/*"],
      "@webiny/api": ["../api/src"],
      "@webiny/api-aco/*": ["../api-aco/src/*"],
      "@webiny/api-aco": ["../api-aco/src"],
      "@webiny/api-audit-logs/*": ["../api-audit-logs/src/*"],
      "@webiny/api-audit-logs": ["../api-audit-logs/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-file-manager/*": ["../api-file-manager/src/*"],
      "@webiny/api-file-manager": ["../api-file-manager/src"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/api-headless-cms-aco/*": ["../api-headless-cms-aco/src/*"],
      "@webiny/api-headless-cms-aco": ["../api-headless-cms-aco/src"],
      "@webiny/api-headless-cms-tasks/*": ["../api-headless-cms-tasks/src/*"],
      "@webiny/api-headless-cms-tasks": ["../api-headless-cms-tasks/src"],
      "@webiny/api-mailer/*": ["../api-mailer/src/*"],
      "@webiny/api-mailer": ["../api-mailer/src"],
      "@webiny/api-opensearch/*": ["../api-opensearch/src/*"],
      "@webiny/api-opensearch": ["../api-opensearch/src"],
      "@webiny/api-record-locking/*": ["../api-record-locking/src/*"],
      "@webiny/api-record-locking": ["../api-record-locking/src"],
      "@webiny/api-website-builder/*": ["../api-website-builder/src/*"],
      "@webiny/api-website-builder": ["../api-website-builder/src"],
      "@webiny/api-websockets/*": ["../api-websockets/src/*"],
      "@webiny/api-websockets": ["../api-websockets/src"],
      "@webiny/aws-sdk/*": ["../aws-sdk/src/*"],
      "@webiny/aws-sdk": ["../aws-sdk/src"],
      "@webiny/background-tasks/api": ["../background-tasks/src/api/index.js"],
      "@webiny/background-tasks/admin/*": ["../background-tasks/src/admin/*"],
      "@webiny/background-tasks/*": ["../background-tasks/src/*"],
      "@webiny/background-tasks": ["../background-tasks/src"],
      "@webiny/error/*": ["../error/src/*"],
      "@webiny/error": ["../error/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/handler-aws/*": ["../handler-aws/src/*"],
      "@webiny/handler-aws": ["../handler-aws/src"],
      "@webiny/handler-graphql/*": ["../handler-graphql/src/*"],
      "@webiny/handler-graphql": ["../handler-graphql/src"],
      "@webiny/plugins/*": ["../plugins/src/*"],
      "@webiny/plugins": ["../plugins/src"],
      "@webiny/wcp/*": ["../wcp/src/*"],
      "@webiny/wcp": ["../wcp/src"]
    }
  }
}
