{
  "name": "@webiny/project-standalone",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webiny/webiny-js.git"
  },
  "description": "Project app factories for standalone Webiny projects.",
  "license": "MIT",
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@electric-sql/pglite-socket": "^0.2.17",
    "@vercel/nft": "^1.11.0",
    "@webiny/build-tools": "0.0.0",
    "@webiny/cli-core": "0.0.0",
    "@webiny/di": "^2.0.0",
    "@webiny/global-config": "0.0.0",
    "@webiny/project": "0.0.0",
    "@webiny/project-extensions-aws": "0.0.0",
    "@webiny/project-extensions-standalone": "0.0.0",
    "react": "19.3.1",
    "replace-in-path": "^1.1.0"
  },
  "devDependencies": {
    "@webiny/build-tools": "0.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "adio": {
    "ignore": {
      "dependencies": [
        "@electric-sql/pglite",
        "@electric-sql/pglite-socket"
      ]
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "webiny": {
    "publishFrom": "dist"
  }
}
