{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "exclude": ["src/services/SetupYarn/binaries"],
  "references": [{ "path": "../mcp/tsconfig.build.json" }],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/mcp/*": ["../mcp/src/*"],
      "@webiny/mcp": ["../mcp/src"]
    }
  }
}
