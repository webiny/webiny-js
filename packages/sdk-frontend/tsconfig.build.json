{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../cms-sdk/tsconfig.build.json" },
    { "path": "../sdk/tsconfig.build.json" },
    { "path": "../theme-sdk/tsconfig.build.json" },
    { "path": "../website-builder-sdk/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/cms-sdk/*": ["../cms-sdk/src/*"],
      "@webiny/cms-sdk": ["../cms-sdk/src"],
      "@webiny/sdk/*": ["../sdk/src/*"],
      "@webiny/sdk": ["../sdk/src"],
      "@webiny/theme-sdk/*": ["../theme-sdk/src/*"],
      "@webiny/theme-sdk": ["../theme-sdk/src"],
      "@webiny/website-builder-sdk/*": ["../website-builder-sdk/src/*"],
      "@webiny/website-builder-sdk": ["../website-builder-sdk/src"]
    }
  }
}
