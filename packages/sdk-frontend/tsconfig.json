{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../cms-sdk" },
    { "path": "../sdk" },
    { "path": "../theme-sdk" },
    { "path": "../website-builder-sdk" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/cms-sdk/*": ["../cms-sdk/src/*"],
      "@webiny/cms-sdk": ["../cms-sdk/src"],
      "@webiny/sdk/*": ["../sdk/src/*"],
      "@webiny/sdk": ["../sdk/src"],
      "@webiny/theme-sdk/*": ["../theme-sdk/src/*"],
      "@webiny/theme-sdk": ["../theme-sdk/src"],
      "@webiny/website-builder-sdk/*": ["../website-builder-sdk/src/*"],
      "@webiny/website-builder-sdk": ["../website-builder-sdk/src"]
    }
  }
}
