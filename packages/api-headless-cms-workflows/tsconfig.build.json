{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api-headless-cms/tsconfig.build.json" },
    { "path": "../api-workflows/tsconfig.build.json" },
    { "path": "../error/tsconfig.build.json" },
    { "path": "../handler/tsconfig.build.json" },
    { "path": "../plugins/tsconfig.build.json" },
    { "path": "../testing/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/api-workflows/*": ["../api-workflows/src/*"],
      "@webiny/api-workflows": ["../api-workflows/src"],
      "@webiny/error/*": ["../error/src/*"],
      "@webiny/error": ["../error/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/plugins/*": ["../plugins/src/*"],
      "@webiny/plugins": ["../plugins/src"],
      "@webiny/testing/*": ["../testing/src/*"],
      "@webiny/testing": ["../testing/src"]
    },
    "baseUrl": "."
  }
}
