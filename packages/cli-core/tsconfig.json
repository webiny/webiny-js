{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [{ "path": "../logger" }, { "path": "../project" }, { "path": "../pulumi-sdk" }],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/logger/*": ["../logger/src/*"],
      "@webiny/logger": ["../logger/src"],
      "@webiny/project/*": ["../project/src/*"],
      "@webiny/project": ["../project/src"],
      "@webiny/pulumi-sdk/*": ["../pulumi-sdk/src/*"],
      "@webiny/pulumi-sdk": ["../pulumi-sdk/src"]
    },
    "baseUrl": "."
  }
}
