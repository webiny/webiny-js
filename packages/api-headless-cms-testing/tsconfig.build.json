{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api-core/tsconfig.build.json" },
    { "path": "../api-core-testing/tsconfig.build.json" },
    { "path": "../api-headless-cms/tsconfig.build.json" },
    { "path": "../event-handler-core/tsconfig.build.json" },
    { "path": "../handler-graphql/tsconfig.build.json" },
    { "path": "../wcp/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-core-testing/*": ["../api-core-testing/src/*"],
      "@webiny/api-core-testing": ["../api-core-testing/src"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/event-handler-core/*": ["../event-handler-core/src/*"],
      "@webiny/event-handler-core": ["../event-handler-core/src"],
      "@webiny/handler-graphql/*": ["../handler-graphql/src/*"],
      "@webiny/handler-graphql": ["../handler-graphql/src"],
      "@webiny/wcp/*": ["../wcp/src/*"],
      "@webiny/wcp": ["../wcp/src"]
    }
  }
}
