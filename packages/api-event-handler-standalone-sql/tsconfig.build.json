{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api-core-sql/tsconfig.build.json" },
    { "path": "../api-event-handler-standalone/tsconfig.build.json" },
    { "path": "../handler/tsconfig.build.json" },
    { "path": "../self-hosted-auth/tsconfig.build.json" },
    { "path": "../self-hosted-auth-sql/tsconfig.build.json" },
    { "path": "../api-aco/tsconfig.build.json" },
    { "path": "../api-aco-pg/tsconfig.build.json" },
    { "path": "../api-audit-logs/tsconfig.build.json" },
    { "path": "../api-core/tsconfig.build.json" },
    { "path": "../api-headless-cms/tsconfig.build.json" },
    { "path": "../api-headless-cms-pg/tsconfig.build.json" },
    { "path": "../api-storage-pg/tsconfig.build.json" },
    { "path": "../api-storage-sqlite/tsconfig.build.json" },
    { "path": "../api-websockets/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-core-sql/*": ["../api-core-sql/src/*"],
      "@webiny/api-core-sql": ["../api-core-sql/src"],
      "@webiny/api-event-handler-standalone/*": ["../api-event-handler-standalone/src/*"],
      "@webiny/api-event-handler-standalone": ["../api-event-handler-standalone/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/self-hosted-auth/*": ["../self-hosted-auth/src/*"],
      "@webiny/self-hosted-auth": ["../self-hosted-auth/src"],
      "@webiny/self-hosted-auth-sql/*": ["../self-hosted-auth-sql/src/*"],
      "@webiny/self-hosted-auth-sql": ["../self-hosted-auth-sql/src"],
      "@webiny/api-aco/*": ["../api-aco/src/*"],
      "@webiny/api-aco": ["../api-aco/src"],
      "@webiny/api-aco-pg/*": ["../api-aco-pg/src/*"],
      "@webiny/api-aco-pg": ["../api-aco-pg/src"],
      "@webiny/api-audit-logs/*": ["../api-audit-logs/src/*"],
      "@webiny/api-audit-logs": ["../api-audit-logs/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/api-headless-cms-pg/*": ["../api-headless-cms-pg/src/*"],
      "@webiny/api-headless-cms-pg": ["../api-headless-cms-pg/src"],
      "@webiny/api-storage-pg/*": ["../api-storage-pg/src/*"],
      "@webiny/api-storage-pg": ["../api-storage-pg/src"],
      "@webiny/api-storage-sqlite/*": ["../api-storage-sqlite/src/*"],
      "@webiny/api-storage-sqlite": ["../api-storage-sqlite/src"],
      "@webiny/api-websockets/*": ["../api-websockets/src/*"],
      "@webiny/api-websockets": ["../api-websockets/src"]
    }
  }
}
