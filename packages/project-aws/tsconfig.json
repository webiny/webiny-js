{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-headless-cms" },
    { "path": "../aws-sdk" },
    { "path": "../cli-core" },
    { "path": "../data-migration" },
    { "path": "../mcp" },
    { "path": "../project" },
    { "path": "../pulumi" },
    { "path": "../utils" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/aws-sdk/*": ["../aws-sdk/src/*"],
      "@webiny/aws-sdk": ["../aws-sdk/src"],
      "@webiny/cli-core/*": ["../cli-core/src/*"],
      "@webiny/cli-core": ["../cli-core/src"],
      "@webiny/data-migration/*": ["../data-migration/src/*"],
      "@webiny/data-migration": ["../data-migration/src"],
      "@webiny/mcp/*": ["../mcp/src/*"],
      "@webiny/mcp": ["../mcp/src"],
      "@webiny/project/*": ["../project/src/*"],
      "@webiny/project": ["../project/src"],
      "@webiny/pulumi/*": ["../pulumi/src/*"],
      "@webiny/pulumi": ["../pulumi/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"]
    }
  }
}
