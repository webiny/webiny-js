{
  "name": "@webiny/project-aws",
  "version": "0.0.0",
  "type": "module",
  "exports": {
      ".": "./index.js",
      "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webiny/webiny-js.git"
  },
  "description": "A set of project apps that together form Webiny CMS, deployed into Amazon Web Services (AWS).",
  "author": "Webiny Ltd",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "dependencies": {
    "@pulumi/aws": "^7.26.0",
    "@pulumi/pulumi": "^3.231.0",
    "@pulumi/random": "^4.19.2",
    "@webiny/api-headless-cms": "0.0.0",
    "@webiny/aws-layers": "0.0.0",
    "@webiny/aws-sdk": "0.0.0",
    "@webiny/cli-core": "0.0.0",
    "@webiny/project": "0.0.0",
    "@webiny/pulumi": "0.0.0",
    "@webiny/utils": "0.0.0",
    "chalk": "^5.6.2",
    "find-up": "^8.0.0",
    "invariant": "^2.2.4",
    "lodash": "^4.18.1",
    "mime": "^4.1.0",
    "react": "18.3.1",
    "replace-in-path": "^1.1.0",
    "ts-morph": "^28.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/ncp": "^2.0.8",
    "@webiny/build-tools": "0.0.0",
    "typescript": "6.0.3"
  },
  "adio": {
    "ignoreDirs": [
      "_templates"
    ],
    "ignore": {
      "src": [
        "listr2",
        "cloudfront"
      ],
      "dependencies": [
        "@pulumi/pulumi",
        "@pulumi/aws"
      ]
    }
  }
}
