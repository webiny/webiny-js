    "@pulumi/pulumi": "^3.242.0",
    "@pulumi/random": "^4.20.0",
    "@webiny/api-headless-cms": "0.0.0",
    "@webiny/aws-layers": "0.0.0",
    "@webiny/aws-sdk": "0.0.0",
    "@webiny/cli-core": "0.0.0",
    "@webiny/di": "^1.0.1",
    "@webiny/project": "0.0.0",
    "@webiny/pulumi": "0.0.0",
    "@webiny/utils": "0.0.0",
    "chalk": "^5.6.2",
    "email-addresses": "^5.0.0",
    "find-up": "^8.0.0",
    "invariant": "^2.2.4",
    "lodash": "^4.18.1",
    "mime": "^4.1.0",
    "react": "18.3.1",
    "replace-in-path": "^1.1.0",
    "ts-morph": "^28.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
