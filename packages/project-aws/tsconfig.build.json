{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api-headless-cms/tsconfig.build.json" },
    { "path": "../aws-sdk/tsconfig.build.json" },
    { "path": "../cli-core/tsconfig.build.json" },
    { "path": "../project/tsconfig.build.json" },
    { "path": "../pulumi/tsconfig.build.json" },
    { "path": "../pulumi-sdk/tsconfig.build.json" },
    { "path": "../utils/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/aws-sdk/*": ["../aws-sdk/src/*"],
      "@webiny/aws-sdk": ["../aws-sdk/src"],
      "@webiny/cli-core/*": ["../cli-core/src/*"],
      "@webiny/cli-core": ["../cli-core/src"],
      "@webiny/project/*": ["../project/src/*"],
      "@webiny/project": ["../project/src"],
      "@webiny/pulumi/*": ["../pulumi/src/*"],
      "@webiny/pulumi": ["../pulumi/src"],
      "@webiny/pulumi-sdk/*": ["../pulumi-sdk/src/*"],
      "@webiny/pulumi-sdk": ["../pulumi-sdk/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"]
    }
  }
}
