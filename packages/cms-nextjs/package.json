{
  "name": "@webiny/cms-nextjs",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/webiny/webiny-js.git"
  },
  "exports": {
    ".": "./index.js",
    "./*": "./*"
  },
  "description": "Next.js integration for Webiny CMS SDK.",
  "contributors": [
    "Pavel Denisjuk <pavel@webiny.com>"
  ],
  "license": "MIT",
  "dependencies": {
    "@webiny/cms-sdk": "0.0.0",
    "mobx-react-lite": "^5.0.3"
  },
  "peerDependencies": {
    "next": ">=15.0.0 <16.0.0",
    "react": ">=19.0.0 <20.0.0"
  },
  "devDependencies": {
    "@webiny/build-tools": "0.0.0",
    "typescript": "7.0.2",
    "vitest": "^5.0.1"
  },
  "adio": {
    "ignore": {
      "dependencies": [
        "@webiny/cms-sdk",
        "mobx-react-lite"
      ]
    }
  },
  "webiny": {
    "publishFrom": "dist"
  },
  "publishConfig": {
    "access": "public"
  }
}
