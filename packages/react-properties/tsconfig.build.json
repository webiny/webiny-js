{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [{ "path": "../react-composition/tsconfig.build.json" }],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/react-composition/*": ["../react-composition/src/*"],
      "@webiny/react-composition": ["../react-composition/src"]
    }
  }
}
