{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../feature/tsconfig.build.json" },
    { "path": "../i18n/tsconfig.build.json" },
    { "path": "../i18n-react/tsconfig.build.json" },
    { "path": "../plugins/tsconfig.build.json" },
    { "path": "../react-composition/tsconfig.build.json" },
    { "path": "../react-properties/tsconfig.build.json" },
    { "path": "../utils/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/feature/api": ["../feature/src/api/index.js"],
      "@webiny/feature/admin": ["../feature/src/admin/index.js"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/i18n/*": ["../i18n/src/*"],
      "@webiny/i18n": ["../i18n/src"],
      "@webiny/i18n-react/*": ["../i18n-react/src/*"],
      "@webiny/i18n-react": ["../i18n-react/src"],
      "@webiny/plugins/*": ["../plugins/src/*"],
      "@webiny/plugins": ["../plugins/src"],
      "@webiny/react-composition/*": ["../react-composition/src/*"],
      "@webiny/react-composition": ["../react-composition/src"],
      "@webiny/react-properties/*": ["../react-properties/src/*"],
      "@webiny/react-properties": ["../react-properties/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"]
    },
    "baseUrl": "."
  }
}
