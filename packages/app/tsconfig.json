{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../feature" },
    { "path": "../i18n" },
    { "path": "../i18n-react" },
    { "path": "../plugins" },
    { "path": "../react-composition" },
    { "path": "../react-properties" },
    { "path": "../utils" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/feature/api": ["../feature/src/api/index.js"],
      "@webiny/feature/admin": ["../feature/src/admin/index.js"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/i18n/*": ["../i18n/src/*"],
      "@webiny/i18n": ["../i18n/src"],
      "@webiny/i18n-react/*": ["../i18n-react/src/*"],
      "@webiny/i18n-react": ["../i18n-react/src"],
      "@webiny/plugins/*": ["../plugins/src/*"],
      "@webiny/plugins": ["../plugins/src"],
      "@webiny/react-composition/*": ["../react-composition/src/*"],
      "@webiny/react-composition": ["../react-composition/src"],
      "@webiny/react-properties/*": ["../react-properties/src/*"],
      "@webiny/react-properties": ["../react-properties/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"]
    },
    "baseUrl": "."
  }
}
