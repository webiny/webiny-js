  "devDependencies": {
    "@types/lodash": "^4.17.21",
    "@types/universal-router": "^8.0.0",
    "@types/warning": "^3.0.3",
    "@webiny/build-tools": "0.0.0",
    "rimraf": "^6.1.2",
    "type-fest": "^5.3.1",
    "typescript": "5.9.3",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  },
  "adio": {
    "ignore": {
      "dependencies": [
        "react-dom"
      ]
    }
  },
  "gitHead": "8476da73b653c89cc1474d968baf55c1b0ae0e5f"
