{
  "name": "@webiny/app",
  "version": "0.0.0",
  "type": "module",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/webiny/webiny-js.git"
  },
  "description": "The base package for building Webiny and React powered web apps.",
  "contributors": [
    "Pavel Denisjuk <pavel@webiny.com>",
    "Sven Al Hamad <sven@webiny.com>",
    "Adrian Smijulj <adrian@webiny.com>"
  ],
  "license": "MIT",
  "webiny": {
    "exports": {
      "./errors/abstractions.ts": {
        "exportPath": "./admin/security",
        "namedExports": [
          "AuthenticationErrorEventHandler"
        ]
      },
      "./shared/di/useFeature.ts": {
        "exportPath": "./admin",
        "namedExports": [
          "useFeature"
        ]
      },
      "./features/envConfig/index.ts": {
        "exportPath": "./admin/envConfig",
        "namedExports": [
          "EnvConfig"
        ]
      },
      "./features/graphqlClient/abstractions.ts": {
        "exportPath": "./admin/graphqlClient",
        "namedExports": [
          "GraphQLClient"
        ]
      },
      "./errors/index.ts": {
        "exportPath": "./admin",
        "namedExports": [
          "NetworkErrorEventHandler"
        ]
      },
      "./features/localStorage/abstractions.ts": {
        "exportPath": "./admin/localStorage",
        "namedExports": [
          "LocalStorage"
        ]
      },
      "./presentation/localStorage/index.ts": {
        "exportPath": "./admin/localStorage",
        "namedExports": [
          "useLocalStorage",
          "useLocalStorageValue",
          "useLocalStorageValues"
        ]
      },
      "./features/router/Route.ts": {
        "exportPath": "./admin/router",
        "namedExports": [
          "Route"
        ]
      },
      "./presentation/router/components/RouteLink.tsx": {
        "exportPath": "./admin/router",
        "namedExports": [
          "RouteLinkComponent"
        ]
      },
      "./presentation/router/components/SimpleLink.tsx": {
        "exportPath": "./admin/router",
        "namedExports": [
          "LinkComponent"
        ]
      },
      "./presentation/router/index.ts": {
        "exportPath": "./admin/router",
        "namedExports": [
          "useRoute",
          "useRouter"
        ]
      }
    }
  },
  "dependencies": {
    "@apollo/react-hooks": "^3.1.5",
    "@emotion/styled": "11.10.6",
    "@types/react": "18.2.79",
    "@webiny/di": "^0.2.3",
    "@webiny/feature": "0.0.0",
    "@webiny/i18n": "0.0.0",
    "@webiny/i18n-react": "0.0.0",
    "@webiny/plugins": "0.0.0",
