    "@webiny/react-properties": "0.0.0",
    "apollo-cache": "^1.3.5",
    "apollo-cache-inmemory": "^1.6.6",
    "apollo-client": "^2.6.10",
    "apollo-link": "^1.2.14",
    "apollo-link-context": "^1.0.20",
    "apollo-link-error": "^1.1.13",
    "apollo-link-http-common": "^0.2.16",
    "apollo-utilities": "^1.3.4",
    "boolean": "^3.2.0",
    "bytes": "^3.1.2",
    "graphql": "^16.12.0",
    "history": "^5.3.0",
    "invariant": "^2.2.4",
    "lodash": "^4.17.21",
    "minimatch": "^5.1.6",
    "mobx": "^6.15.0",
    "nanoid": "^3.3.11",
    "path-to-regexp": "^8.3.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "ts-invariant": "^0.10.3",
