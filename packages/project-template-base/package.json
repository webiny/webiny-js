{
  "name": "@webiny/project-template-base",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webiny/webiny-js.git"
  },
  "description": "Shared base config extensions for Webiny project templates (aws + server flavours).",
  "license": "MIT",
  "dependencies": {
    "@webiny/ai-powerups": "0.0.0",
    "@webiny/languages": "0.0.0",
    "@webiny/tenant-manager": "0.0.0",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@webiny/build-tools": "0.0.0",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "webiny": {
    "publishFrom": "dist"
  }
