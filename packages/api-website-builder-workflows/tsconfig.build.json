{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api-aco/tsconfig.build.json" },
    { "path": "../api-core/tsconfig.build.json" },
    { "path": "../api-graphql/tsconfig.build.json" },
    { "path": "../api-headless-cms/tsconfig.build.json" },
    { "path": "../api-headless-cms-workflows/tsconfig.build.json" },
    { "path": "../api-website-builder/tsconfig.build.json" },
    { "path": "../api-workflows/tsconfig.build.json" },
    { "path": "../feature/tsconfig.build.json" },
    { "path": "../utils/tsconfig.build.json" },
    { "path": "../api-headless-cms-testing/tsconfig.build.json" },
    { "path": "../api-mailer/tsconfig.build.json" },
    { "path": "../api-websockets/tsconfig.build.json" },
    { "path": "../background-tasks/tsconfig.build.json" },
    { "path": "../languages/tsconfig.build.json" },
    { "path": "../plugins/tsconfig.build.json" },
    { "path": "../wcp/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-aco/*": ["../api-aco/src/*"],
      "@webiny/api-aco": ["../api-aco/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-graphql/*": ["../api-graphql/src/*"],
      "@webiny/api-graphql": ["../api-graphql/src"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/api-headless-cms-workflows/*": ["../api-headless-cms-workflows/src/*"],
      "@webiny/api-headless-cms-workflows": ["../api-headless-cms-workflows/src"],
      "@webiny/api-website-builder/*": ["../api-website-builder/src/*"],
      "@webiny/api-website-builder": ["../api-website-builder/src"],
      "@webiny/api-workflows/*": ["../api-workflows/src/*"],
      "@webiny/api-workflows": ["../api-workflows/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"],
      "@webiny/api-headless-cms-testing/*": ["../api-headless-cms-testing/src/*"],
      "@webiny/api-headless-cms-testing": ["../api-headless-cms-testing/src"],
      "@webiny/api-mailer/*": ["../api-mailer/src/*"],
      "@webiny/api-mailer": ["../api-mailer/src"],
      "@webiny/api-websockets/*": ["../api-websockets/src/*"],
      "@webiny/api-websockets": ["../api-websockets/src"],
      "@webiny/background-tasks/*": ["../background-tasks/src/*"],
      "@webiny/background-tasks": ["../background-tasks/src"],
      "@webiny/languages/*": ["../languages/src/*"],
      "@webiny/languages": ["../languages/src"],
      "@webiny/plugins/*": ["../plugins/src/*"],
      "@webiny/plugins": ["../plugins/src"],
      "@webiny/wcp/*": ["../wcp/src/*"],
      "@webiny/wcp": ["../wcp/src"]
    }
  }
}
