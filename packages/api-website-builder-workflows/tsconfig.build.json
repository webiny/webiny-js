{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api/tsconfig.build.json" },
    { "path": "../api-core/tsconfig.build.json" },
    { "path": "../api-website-builder/tsconfig.build.json" },
    { "path": "../api-workflows/tsconfig.build.json" },
    { "path": "../error/tsconfig.build.json" },
    { "path": "../feature/tsconfig.build.json" },
    { "path": "../handler-graphql/tsconfig.build.json" },
    { "path": "../plugins/tsconfig.build.json" },
    { "path": "../testing/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api/*": ["../api/src/*"],
      "@webiny/api": ["../api/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-website-builder/*": ["../api-website-builder/src/*"],
      "@webiny/api-website-builder": ["../api-website-builder/src"],
      "@webiny/api-workflows/*": ["../api-workflows/src/*"],
      "@webiny/api-workflows": ["../api-workflows/src"],
      "@webiny/error/*": ["../error/src/*"],
      "@webiny/error": ["../error/src"],
      "@webiny/feature/api": ["../feature/src/api/index.js"],
      "@webiny/feature/admin": ["../feature/src/admin/index.js"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/handler-graphql/*": ["../handler-graphql/src/*"],
      "@webiny/handler-graphql": ["../handler-graphql/src"],
      "@webiny/plugins/*": ["../plugins/src/*"],
      "@webiny/plugins": ["../plugins/src"],
      "@webiny/testing/*": ["../testing/src/*"],
      "@webiny/testing": ["../testing/src"]
    }
  }
}
