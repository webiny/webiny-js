{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-core" },
    { "path": "../api-file-manager" },
    { "path": "../api-graphql" },
    { "path": "../api-kernel-core" },
    { "path": "../api-object-storage" },
    { "path": "../background-tasks" },
    { "path": "../feature" },
    { "path": "../handler" },
    { "path": "../plugins" },
    { "path": "../validation" },
    { "path": "../api-object-storage-disk" },
    { "path": "../api-object-storage-s3" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-file-manager/*": ["../api-file-manager/src/*"],
      "@webiny/api-file-manager": ["../api-file-manager/src"],
      "@webiny/api-graphql/*": ["../api-graphql/src/*"],
      "@webiny/api-graphql": ["../api-graphql/src"],
      "@webiny/api-kernel-core/*": ["../api-kernel-core/src/*"],
      "@webiny/api-kernel-core": ["../api-kernel-core/src"],
      "@webiny/api-object-storage/*": ["../api-object-storage/src/*"],
      "@webiny/api-object-storage": ["../api-object-storage/src"],
      "@webiny/background-tasks/*": ["../background-tasks/src/*"],
      "@webiny/background-tasks": ["../background-tasks/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/plugins/*": ["../plugins/src/*"],
      "@webiny/plugins": ["../plugins/src"],
      "@webiny/validation/*": ["../validation/src/*"],
      "@webiny/validation": ["../validation/src"],
      "@webiny/api-object-storage-disk/*": ["../api-object-storage-disk/src/*"],
      "@webiny/api-object-storage-disk": ["../api-object-storage-disk/src"],
      "@webiny/api-object-storage-s3/*": ["../api-object-storage-s3/src/*"],
      "@webiny/api-object-storage-s3": ["../api-object-storage-s3/src"]
    }
  }
}
