{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [{ "path": "../api-scheduler/tsconfig.build.json" }],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-scheduler/*": ["../api-scheduler/src/*"],
      "@webiny/api-scheduler": ["../api-scheduler/src"]
    }
  }
}
