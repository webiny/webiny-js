{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../cli-core/tsconfig.build.json" },
    { "path": "../mcp/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/cli-core/*": ["../cli-core/src/*"],
      "@webiny/cli-core": ["../cli-core/src"],
      "@webiny/mcp/*": ["../mcp/src/*"],
      "@webiny/mcp": ["../mcp/src"]
    },
    "baseUrl": "."
  }
}
