{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-file-manager-standalone" },
    { "path": "../aws-sdk" },
    { "path": "../feature" },
    { "path": "../project" },
    { "path": "../api-core" },
    { "path": "../api-file-manager" },
    { "path": "../event-handler-core" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-file-manager-standalone/*": ["../api-file-manager-standalone/src/*"],
      "@webiny/api-file-manager-standalone": ["../api-file-manager-standalone/src"],
      "@webiny/aws-sdk/*": ["../aws-sdk/src/*"],
      "@webiny/aws-sdk": ["../aws-sdk/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/project/*": ["../project/src/*"],
      "@webiny/project": ["../project/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-file-manager/*": ["../api-file-manager/src/*"],
      "@webiny/api-file-manager": ["../api-file-manager/src"],
      "@webiny/event-handler-core/*": ["../event-handler-core/src/*"],
      "@webiny/event-handler-core": ["../event-handler-core/src"]
    }
  }
}
