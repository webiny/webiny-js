{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api-core/tsconfig.build.json" },
    { "path": "../api-core-sql/tsconfig.build.json" },
    { "path": "../api-event-handler-aws/tsconfig.build.json" },
    { "path": "../api-storage-pg/tsconfig.build.json" },
    { "path": "../aws-sdk/tsconfig.build.json" },
    { "path": "../api-aco-pg/tsconfig.build.json" },
    { "path": "../api-audit-logs/tsconfig.build.json" },
    { "path": "../api-headless-cms-pg/tsconfig.build.json" },
    { "path": "../api-websockets/tsconfig.build.json" },
    { "path": "../handler/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-core-sql/*": ["../api-core-sql/src/*"],
      "@webiny/api-core-sql": ["../api-core-sql/src"],
      "@webiny/api-event-handler-aws/*": ["../api-event-handler-aws/src/*"],
      "@webiny/api-event-handler-aws": ["../api-event-handler-aws/src"],
      "@webiny/api-storage-pg/*": ["../api-storage-pg/src/*"],
      "@webiny/api-storage-pg": ["../api-storage-pg/src"],
      "@webiny/aws-sdk/*": ["../aws-sdk/src/*"],
      "@webiny/aws-sdk": ["../aws-sdk/src"],
      "@webiny/api-aco-pg/*": ["../api-aco-pg/src/*"],
      "@webiny/api-aco-pg": ["../api-aco-pg/src"],
      "@webiny/api-audit-logs/*": ["../api-audit-logs/src/*"],
      "@webiny/api-audit-logs": ["../api-audit-logs/src"],
      "@webiny/api-headless-cms-pg/*": ["../api-headless-cms-pg/src/*"],
      "@webiny/api-headless-cms-pg": ["../api-headless-cms-pg/src"],
      "@webiny/api-websockets/*": ["../api-websockets/src/*"],
      "@webiny/api-websockets": ["../api-websockets/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"]
    }
  }
}
