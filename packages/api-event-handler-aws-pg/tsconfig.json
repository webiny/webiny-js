{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-core" },
    { "path": "../api-core-sql" },
    { "path": "../api-event-handler-aws" },
    { "path": "../api-event-handler-core" },
    { "path": "../api-storage-pg" },
    { "path": "../aws-sdk" },
    { "path": "../event-handler-aws" },
    { "path": "../event-handler-core" },
    { "path": "../feature" },
    { "path": "../api-aco-pg" },
    { "path": "../api-audit-logs" },
    { "path": "../api-headless-cms-pg" },
    { "path": "../api-websockets" },
    { "path": "../handler" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-core-sql/*": ["../api-core-sql/src/*"],
      "@webiny/api-core-sql": ["../api-core-sql/src"],
      "@webiny/api-event-handler-aws/*": ["../api-event-handler-aws/src/*"],
      "@webiny/api-event-handler-aws": ["../api-event-handler-aws/src"],
      "@webiny/api-event-handler-core/*": ["../api-event-handler-core/src/*"],
      "@webiny/api-event-handler-core": ["../api-event-handler-core/src"],
      "@webiny/api-storage-pg/*": ["../api-storage-pg/src/*"],
      "@webiny/api-storage-pg": ["../api-storage-pg/src"],
      "@webiny/aws-sdk/*": ["../aws-sdk/src/*"],
      "@webiny/aws-sdk": ["../aws-sdk/src"],
      "@webiny/event-handler-aws/*": ["../event-handler-aws/src/*"],
      "@webiny/event-handler-aws": ["../event-handler-aws/src"],
      "@webiny/event-handler-core/*": ["../event-handler-core/src/*"],
      "@webiny/event-handler-core": ["../event-handler-core/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/api-aco-pg/*": ["../api-aco-pg/src/*"],
      "@webiny/api-aco-pg": ["../api-aco-pg/src"],
      "@webiny/api-audit-logs/*": ["../api-audit-logs/src/*"],
      "@webiny/api-audit-logs": ["../api-audit-logs/src"],
      "@webiny/api-headless-cms-pg/*": ["../api-headless-cms-pg/src/*"],
      "@webiny/api-headless-cms-pg": ["../api-headless-cms-pg/src"],
      "@webiny/api-websockets/*": ["../api-websockets/src/*"],
      "@webiny/api-websockets": ["../api-websockets/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"]
    }
  }
}
