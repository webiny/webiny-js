{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [{ "path": "../feature/tsconfig.build.json" }],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"]
    }
  }
}
