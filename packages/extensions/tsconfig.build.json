{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../project-aws/tsconfig.build.json" },
    { "path": "../react-properties/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/project-aws/*": ["../project-aws/src/*"],
      "@webiny/project-aws": ["../project-aws/src"],
      "@webiny/react-properties/*": ["../react-properties/src/*"],
      "@webiny/react-properties": ["../react-properties/src"]
    },
    "baseUrl": "."
  }
}
