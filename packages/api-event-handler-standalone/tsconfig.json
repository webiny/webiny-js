{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-core" },
    { "path": "../api-event-handler-core" },
    { "path": "../api-file-manager-standalone" },
    { "path": "../api-graphql" },
    { "path": "../api-headless-cms-bulk-actions-standalone" },
    { "path": "../api-scheduler" },
    { "path": "../api-scheduler-standalone" },
    { "path": "../api-websockets-standalone" },
    { "path": "../background-tasks-standalone" },
    { "path": "../event-handler-core" },
    { "path": "../event-handler-standalone" },
    { "path": "../feature" },
    { "path": "../handler" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-event-handler-core/*": ["../api-event-handler-core/src/*"],
      "@webiny/api-event-handler-core": ["../api-event-handler-core/src"],
      "@webiny/api-file-manager-standalone/*": ["../api-file-manager-standalone/src/*"],
      "@webiny/api-file-manager-standalone": ["../api-file-manager-standalone/src"],
      "@webiny/api-graphql/*": ["../api-graphql/src/*"],
      "@webiny/api-graphql": ["../api-graphql/src"],
      "@webiny/api-headless-cms-bulk-actions-standalone/*": [
        "../api-headless-cms-bulk-actions-standalone/src/*"
      ],
      "@webiny/api-headless-cms-bulk-actions-standalone": [
        "../api-headless-cms-bulk-actions-standalone/src"
      ],
      "@webiny/api-scheduler/*": ["../api-scheduler/src/*"],
      "@webiny/api-scheduler": ["../api-scheduler/src"],
      "@webiny/api-scheduler-standalone/*": ["../api-scheduler-standalone/src/*"],
      "@webiny/api-scheduler-standalone": ["../api-scheduler-standalone/src"],
      "@webiny/api-websockets-standalone/*": ["../api-websockets-standalone/src/*"],
      "@webiny/api-websockets-standalone": ["../api-websockets-standalone/src"],
      "@webiny/background-tasks-standalone/*": ["../background-tasks-standalone/src/*"],
      "@webiny/background-tasks-standalone": ["../background-tasks-standalone/src"],
      "@webiny/event-handler-core/*": ["../event-handler-core/src/*"],
      "@webiny/event-handler-core": ["../event-handler-core/src"],
      "@webiny/event-handler-standalone/*": ["../event-handler-standalone/src/*"],
      "@webiny/event-handler-standalone": ["../event-handler-standalone/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"]
    }
  }
}
