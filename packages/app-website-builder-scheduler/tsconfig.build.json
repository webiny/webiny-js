{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../admin-ui/tsconfig.build.json" },
    { "path": "../app-scheduler/tsconfig.build.json" },
    { "path": "../app-website-builder/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/admin-ui/*": ["../admin-ui/src/*"],
      "@webiny/admin-ui": ["../admin-ui/src"],
      "@webiny/app-scheduler/*": ["../app-scheduler/src/*"],
      "@webiny/app-scheduler": ["../app-scheduler/src"],
      "@webiny/app-website-builder/*": ["../app-website-builder/src/*"],
      "@webiny/app-website-builder": ["../app-website-builder/src"]
    },
    "baseUrl": "."
  }
}
