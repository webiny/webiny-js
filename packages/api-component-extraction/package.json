    "@webiny/api-headless-cms": "0.0.0",
    "@webiny/api-theme": "0.0.0",
    "@webiny/api-websockets": "0.0.0",
    "@webiny/aws-sdk": "0.0.0",
    "@webiny/background-tasks": "0.0.0",
    "@webiny/event-handler-core": "0.0.0",
    "@webiny/feature": "0.0.0",
    "@webiny/remote-components": "0.0.0",
    "@webiny/site-capture": "0.0.0",
    "@webiny/theme-common": "0.0.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
