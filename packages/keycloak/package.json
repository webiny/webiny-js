{
  "name": "@webiny/keycloak",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.js",
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webiny/webiny-js.git"
  },
  "description": "Security plugins for Keycloak. Mirrors @webiny/auth0 + @webiny/okta for OIDC IdPs running on a customer-controlled Keycloak instance.",
  "author": "Webiny Ltd.",
  "license": "MIT",
  "dependencies": {
    "@webiny/api-core": "0.0.0",
    "@webiny/feature": "0.0.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@webiny/build-tools": "0.0.0",
    "rimraf": "^6.1.3",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "directory": "dist"
  }
}
