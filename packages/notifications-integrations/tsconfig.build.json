{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api-core/tsconfig.build.json" },
    { "path": "../api-workflows/tsconfig.build.json" },
    { "path": "../collaboration/tsconfig.build.json" },
    { "path": "../feature/tsconfig.build.json" },
    { "path": "../notifications/tsconfig.build.json" },
    { "path": "../project-aws/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-workflows/*": ["../api-workflows/src/*"],
      "@webiny/api-workflows": ["../api-workflows/src"],
      "@webiny/collaboration/*": ["../collaboration/src/*"],
      "@webiny/collaboration": ["../collaboration/src"],
      "@webiny/feature/api": ["../feature/src/api/index.js"],
      "@webiny/feature/admin": ["../feature/src/admin/index.js"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/notifications/*": ["../notifications/src/*"],
      "@webiny/notifications": ["../notifications/src"],
      "@webiny/project-aws/*": ["../project-aws/src/*"],
      "@webiny/project-aws": ["../project-aws/src"]
    }
  }
}
