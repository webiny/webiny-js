{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api-workflows/tsconfig.build.json" },
    { "path": "../collaboration/tsconfig.build.json" },
    { "path": "../extensions/tsconfig.build.json" },
    { "path": "../feature/tsconfig.build.json" },
    { "path": "../notifications/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-workflows/*": ["../api-workflows/src/*"],
      "@webiny/api-workflows": ["../api-workflows/src"],
      "@webiny/collaboration/*": ["../collaboration/src/*"],
      "@webiny/collaboration": ["../collaboration/src"],
      "@webiny/extensions/*": ["../extensions/src/*"],
      "@webiny/extensions": ["../extensions/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/notifications/*": ["../notifications/src/*"],
      "@webiny/notifications": ["../notifications/src"]
    }
  }
}
