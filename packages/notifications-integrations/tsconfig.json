{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-core" },
    { "path": "../api-workflows" },
    { "path": "../collaboration" },
    { "path": "../feature" },
    { "path": "../notifications" },
    { "path": "../project-aws" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-workflows/*": ["../api-workflows/src/*"],
      "@webiny/api-workflows": ["../api-workflows/src"],
      "@webiny/collaboration/*": ["../collaboration/src/*"],
      "@webiny/collaboration": ["../collaboration/src"],
      "@webiny/feature/api": ["../feature/src/api/index.js"],
      "@webiny/feature/admin": ["../feature/src/admin/index.js"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/notifications/*": ["../notifications/src/*"],
      "@webiny/notifications": ["../notifications/src"],
      "@webiny/project-aws/*": ["../project-aws/src/*"],
      "@webiny/project-aws": ["../project-aws/src"]
    }
  }
}
