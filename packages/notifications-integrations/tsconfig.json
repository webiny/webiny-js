{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-workflows" },
    { "path": "../collaboration" },
    { "path": "../extensions" },
    { "path": "../feature" },
    { "path": "../notifications" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-workflows/*": ["../api-workflows/src/*"],
      "@webiny/api-workflows": ["../api-workflows/src"],
      "@webiny/collaboration/*": ["../collaboration/src/*"],
      "@webiny/collaboration": ["../collaboration/src"],
      "@webiny/extensions/*": ["../extensions/src/*"],
      "@webiny/extensions": ["../extensions/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/notifications/*": ["../notifications/src/*"],
      "@webiny/notifications": ["../notifications/src"]
    }
  }
}
