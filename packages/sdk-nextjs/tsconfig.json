{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../cms-nextjs" },
    { "path": "../sdk-frontend" },
    { "path": "../website-builder-nextjs" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/cms-nextjs/*": ["../cms-nextjs/src/*"],
      "@webiny/cms-nextjs": ["../cms-nextjs/src"],
      "@webiny/sdk-frontend/*": ["../sdk-frontend/src/*"],
      "@webiny/sdk-frontend": ["../sdk-frontend/src"],
      "@webiny/website-builder-nextjs/middleware": ["../website-builder-nextjs/src/middleware.js"],
      "@webiny/website-builder-nextjs/webpack": ["../website-builder-nextjs/src/webpack.js"],
      "@webiny/website-builder-nextjs/*": ["../website-builder-nextjs/src/*"],
      "@webiny/website-builder-nextjs": ["../website-builder-nextjs/src"]
    }
  }
}
