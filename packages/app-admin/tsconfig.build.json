{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../admin-ui/tsconfig.build.json" },
    { "path": "../app/tsconfig.build.json" },
    { "path": "../app-security/tsconfig.build.json" },
    { "path": "../di-container/tsconfig.build.json" },
    { "path": "../form/tsconfig.build.json" },
    { "path": "../lexical-editor/tsconfig.build.json" },
    { "path": "../lexical-theme/tsconfig.build.json" },
    { "path": "../plugins/tsconfig.build.json" },
    { "path": "../project/tsconfig.build.json" },
    { "path": "../react-composition/tsconfig.build.json" },
    { "path": "../react-properties/tsconfig.build.json" },
    { "path": "../ui/tsconfig.build.json" },
    { "path": "../utils/tsconfig.build.json" },
    { "path": "../wcp/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/admin-ui/*": ["../admin-ui/src/*"],
      "@webiny/admin-ui": ["../admin-ui/src"],
      "@webiny/app/features/envConfig": ["../app/src/features/envConfig/index.js"],
      "@webiny/app/features/localStorage": ["../app/src/features/localStorage/index.js"],
      "@webiny/app/features/router": ["../app/src/features/router/index.js"],
      "@webiny/app/features/graphqlClient": ["../app/src/features/graphqlClient/index.js"],
      "@webiny/app/*": ["../app/src/*"],
      "@webiny/app": ["../app/src"],
      "@webiny/app-security/*": ["../app-security/src/*"],
      "@webiny/app-security": ["../app-security/src"],
      "@webiny/di-container/*": ["../di-container/src/*"],
      "@webiny/di-container": ["../di-container/src"],
      "@webiny/form/*": ["../form/src/*"],
      "@webiny/form": ["../form/src"],
      "@webiny/lexical-editor/*": ["../lexical-editor/src/*"],
      "@webiny/lexical-editor": ["../lexical-editor/src"],
      "@webiny/lexical-theme/*": ["../lexical-theme/src/*"],
      "@webiny/lexical-theme": ["../lexical-theme/src"],
      "@webiny/plugins/*": ["../plugins/src/*"],
      "@webiny/plugins": ["../plugins/src"],
      "@webiny/project/*": ["../project/src/*"],
      "@webiny/project": ["../project/src"],
      "@webiny/react-composition/*": ["../react-composition/src/*"],
      "@webiny/react-composition": ["../react-composition/src"],
      "@webiny/react-properties/*": ["../react-properties/src/*"],
      "@webiny/react-properties": ["../react-properties/src"],
      "@webiny/ui/*": ["../ui/src/*"],
      "@webiny/ui": ["../ui/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"],
      "@webiny/wcp/*": ["../wcp/src/*"],
      "@webiny/wcp": ["../wcp/src"]
    },
    "baseUrl": "."
  }
}
