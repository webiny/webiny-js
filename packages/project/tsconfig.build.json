{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../feature-flags/tsconfig.build.json" },
    { "path": "../react-properties/tsconfig.build.json" },
    { "path": "../utils/tsconfig.build.json" },
    { "path": "../wcp/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/feature-flags/*": ["../feature-flags/src/*"],
      "@webiny/feature-flags": ["../feature-flags/src"],
      "@webiny/react-properties/*": ["../react-properties/src/*"],
      "@webiny/react-properties": ["../react-properties/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"],
      "@webiny/wcp/*": ["../wcp/src/*"],
      "@webiny/wcp": ["../wcp/src"]
    }
  }
}
