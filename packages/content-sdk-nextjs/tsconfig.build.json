{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../cms-nextjs/tsconfig.build.json" },
    { "path": "../content-sdk/tsconfig.build.json" },
    { "path": "../website-builder-nextjs/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/cms-nextjs/*": ["../cms-nextjs/src/*"],
      "@webiny/cms-nextjs": ["../cms-nextjs/src"],
      "@webiny/content-sdk/*": ["../content-sdk/src/*"],
      "@webiny/content-sdk": ["../content-sdk/src"],
      "@webiny/website-builder-nextjs/middleware": ["../website-builder-nextjs/src/middleware.js"],
      "@webiny/website-builder-nextjs/webpack": ["../website-builder-nextjs/src/webpack.js"],
      "@webiny/website-builder-nextjs/*": ["../website-builder-nextjs/src/*"],
      "@webiny/website-builder-nextjs": ["../website-builder-nextjs/src"]
    }
  }
}
