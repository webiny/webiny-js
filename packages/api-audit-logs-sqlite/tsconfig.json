{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-audit-logs" },
    { "path": "../db-sqlite" },
    { "path": "../error" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-audit-logs/*": ["../api-audit-logs/src/*"],
      "@webiny/api-audit-logs": ["../api-audit-logs/src"],
      "@webiny/db-sqlite/*": ["../db-sqlite/src/*"],
      "@webiny/db-sqlite": ["../db-sqlite/src"],
      "@webiny/error/*": ["../error/src/*"],
      "@webiny/error": ["../error/src"]
    }
  }
}
