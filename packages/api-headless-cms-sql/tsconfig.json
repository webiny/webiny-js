{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-core-sql" },
    { "path": "../api-headless-cms" },
    { "path": "../api-headless-cms-storage" },
    { "path": "../db-utils" },
    { "path": "../feature" },
    { "path": "../handler" },
    { "path": "../plugins" },
    { "path": "../utils" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-core-sql/*": ["../api-core-sql/src/*"],
      "@webiny/api-core-sql": ["../api-core-sql/src"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/api-headless-cms-storage/*": ["../api-headless-cms-storage/src/*"],
      "@webiny/api-headless-cms-storage": ["../api-headless-cms-storage/src"],
      "@webiny/db-utils/*": ["../db-utils/src/*"],
      "@webiny/db-utils": ["../db-utils/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/plugins/*": ["../plugins/src/*"],
      "@webiny/plugins": ["../plugins/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"]
    }
  }
}
