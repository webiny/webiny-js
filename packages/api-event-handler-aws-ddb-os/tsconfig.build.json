{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api-aco-ddb/tsconfig.build.json" },
    { "path": "../api-audit-logs-ddb/tsconfig.build.json" },
    { "path": "../api-core-ddb/tsconfig.build.json" },
    { "path": "../api-event-handler-aws/tsconfig.build.json" },
    { "path": "../api-headless-cms-ddb-es/tsconfig.build.json" },
    { "path": "../api-opensearch/tsconfig.build.json" },
    { "path": "../api-opensearch-aws/tsconfig.build.json" },
    { "path": "../api-websockets-aws/tsconfig.build.json" },
    { "path": "../db/tsconfig.build.json" },
    { "path": "../api-aco/tsconfig.build.json" },
    { "path": "../api-audit-logs/tsconfig.build.json" },
    { "path": "../api-core/tsconfig.build.json" },
    { "path": "../api-headless-cms/tsconfig.build.json" },
    { "path": "../api-websockets/tsconfig.build.json" },
    { "path": "../cognito/tsconfig.build.json" },
    { "path": "../db-dynamodb/tsconfig.build.json" },
    { "path": "../handler/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-aco-ddb/*": ["../api-aco-ddb/src/*"],
      "@webiny/api-aco-ddb": ["../api-aco-ddb/src"],
      "@webiny/api-audit-logs-ddb/*": ["../api-audit-logs-ddb/src/*"],
      "@webiny/api-audit-logs-ddb": ["../api-audit-logs-ddb/src"],
      "@webiny/api-core-ddb/*": ["../api-core-ddb/src/*"],
      "@webiny/api-core-ddb": ["../api-core-ddb/src"],
      "@webiny/api-event-handler-aws/*": ["../api-event-handler-aws/src/*"],
      "@webiny/api-event-handler-aws": ["../api-event-handler-aws/src"],
      "@webiny/api-headless-cms-ddb-es/*": ["../api-headless-cms-ddb-es/src/*"],
      "@webiny/api-headless-cms-ddb-es": ["../api-headless-cms-ddb-es/src"],
      "@webiny/api-opensearch/*": ["../api-opensearch/src/*"],
      "@webiny/api-opensearch": ["../api-opensearch/src"],
      "@webiny/api-opensearch-aws/*": ["../api-opensearch-aws/src/*"],
      "@webiny/api-opensearch-aws": ["../api-opensearch-aws/src"],
      "@webiny/api-websockets-aws/*": ["../api-websockets-aws/src/*"],
      "@webiny/api-websockets-aws": ["../api-websockets-aws/src"],
      "@webiny/db/*": ["../db/src/*"],
      "@webiny/db": ["../db/src"],
      "@webiny/api-aco/*": ["../api-aco/src/*"],
      "@webiny/api-aco": ["../api-aco/src"],
      "@webiny/api-audit-logs/*": ["../api-audit-logs/src/*"],
      "@webiny/api-audit-logs": ["../api-audit-logs/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/api-websockets/*": ["../api-websockets/src/*"],
      "@webiny/api-websockets": ["../api-websockets/src"],
      "@webiny/cognito/*": ["../cognito/src/*"],
      "@webiny/cognito": ["../cognito/src"],
      "@webiny/db-dynamodb/*": ["../db-dynamodb/src/*"],
      "@webiny/db-dynamodb": ["../db-dynamodb/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"]
    }
  }
}
