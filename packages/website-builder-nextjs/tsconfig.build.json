{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [{ "path": "../website-builder-react/tsconfig.build.json" }],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/website-builder-react/*": ["../website-builder-react/src/*"],
      "@webiny/website-builder-react": ["../website-builder-react/src"]
    }
  }
}
