{
  "name": "@webiny/bug-reporter",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./index.js",
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webiny/webiny-js.git"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "description": "Internal bug reporter: describe a bug in the admin app and file it on GitHub.",
  "author": "Webiny Ltd.",
  "license": "Webiny Enterprise",
  "dependencies": {
    "@webiny/admin-ui": "0.0.0",
    "@webiny/api-core": "0.0.0",
    "@webiny/app": "0.0.0",
    "@webiny/app-admin": "0.0.0",
    "@webiny/event-handler-core": "0.0.0",
    "@webiny/feature": "0.0.0",
    "@webiny/icons": "0.0.0",
    "@webiny/project-aws": "0.0.0",
    "mobx": "^7.0.3",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@webiny/build-tools": "0.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "webiny": {
    "publishFrom": "dist"
  }
}
