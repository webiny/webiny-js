{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [{ "path": "../website-builder-vue" }],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/website-builder-vue/*": ["../website-builder-vue/src/*"],
      "@webiny/website-builder-vue": ["../website-builder-vue/src"]
    }
  }
}
