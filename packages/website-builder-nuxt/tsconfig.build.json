{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [{ "path": "../website-builder-vue/tsconfig.build.json" }],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/website-builder-vue/*": ["../website-builder-vue/src/*"],
      "@webiny/website-builder-vue": ["../website-builder-vue/src"]
    },
    "baseUrl": "."
  }
}
