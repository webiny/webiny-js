{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-aco-ddb" },
    { "path": "../api-audit-logs-ddb" },
    { "path": "../api-core-ddb" },
    { "path": "../api-event-handler-aws" },
    { "path": "../api-headless-cms-ddb" },
    { "path": "../api-websockets-aws" },
    { "path": "../api-core" },
    { "path": "../db-dynamodb" },
    { "path": "../feature-flags" },
    { "path": "../handler" },
    { "path": "../wcp" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-aco-ddb/*": ["../api-aco-ddb/src/*"],
      "@webiny/api-aco-ddb": ["../api-aco-ddb/src"],
      "@webiny/api-audit-logs-ddb/*": ["../api-audit-logs-ddb/src/*"],
      "@webiny/api-audit-logs-ddb": ["../api-audit-logs-ddb/src"],
      "@webiny/api-core-ddb/*": ["../api-core-ddb/src/*"],
      "@webiny/api-core-ddb": ["../api-core-ddb/src"],
      "@webiny/api-event-handler-aws/*": ["../api-event-handler-aws/src/*"],
      "@webiny/api-event-handler-aws": ["../api-event-handler-aws/src"],
      "@webiny/api-headless-cms-ddb/*": ["../api-headless-cms-ddb/src/*"],
      "@webiny/api-headless-cms-ddb": ["../api-headless-cms-ddb/src"],
      "@webiny/api-websockets-aws/*": ["../api-websockets-aws/src/*"],
      "@webiny/api-websockets-aws": ["../api-websockets-aws/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/db-dynamodb/*": ["../db-dynamodb/src/*"],
      "@webiny/db-dynamodb": ["../db-dynamodb/src"],
      "@webiny/feature-flags/*": ["../feature-flags/src/*"],
      "@webiny/feature-flags": ["../feature-flags/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/wcp/*": ["../wcp/src/*"],
      "@webiny/wcp": ["../wcp/src"]
    }
  }
}
