{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api/tsconfig.build.json" },
    { "path": "../api-core/tsconfig.build.json" },
    { "path": "../api-opensearch/tsconfig.build.json" },
    { "path": "../api-sync-to-opensearch/tsconfig.build.json" },
    { "path": "../aws-sdk/tsconfig.build.json" },
    { "path": "../background-tasks/tsconfig.build.json" },
    { "path": "../db/tsconfig.build.json" },
    { "path": "../db-dynamodb/tsconfig.build.json" },
    { "path": "../error/tsconfig.build.json" },
    { "path": "../feature/tsconfig.build.json" },
    { "path": "../utils/tsconfig.build.json" },
    { "path": "../api-headless-cms-testing/tsconfig.build.json" },
    { "path": "../handler/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api/*": ["../api/src/*"],
      "@webiny/api": ["../api/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-opensearch/*": ["../api-opensearch/src/*"],
      "@webiny/api-opensearch": ["../api-opensearch/src"],
      "@webiny/api-sync-to-opensearch/*": ["../api-sync-to-opensearch/src/*"],
      "@webiny/api-sync-to-opensearch": ["../api-sync-to-opensearch/src"],
      "@webiny/aws-sdk/*": ["../aws-sdk/src/*"],
      "@webiny/aws-sdk": ["../aws-sdk/src"],
      "@webiny/background-tasks/*": ["../background-tasks/src/*"],
      "@webiny/background-tasks": ["../background-tasks/src"],
      "@webiny/db/*": ["../db/src/*"],
      "@webiny/db": ["../db/src"],
      "@webiny/db-dynamodb/*": ["../db-dynamodb/src/*"],
      "@webiny/db-dynamodb": ["../db-dynamodb/src"],
      "@webiny/error/*": ["../error/src/*"],
      "@webiny/error": ["../error/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"],
      "@webiny/api-headless-cms-testing/*": ["../api-headless-cms-testing/src/*"],
      "@webiny/api-headless-cms-testing": ["../api-headless-cms-testing/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"]
    }
  }
}
