{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api-aco/tsconfig.build.json" },
    { "path": "../api-core/tsconfig.build.json" },
    { "path": "../api-core-sql/tsconfig.build.json" },
    { "path": "../api-headless-cms/tsconfig.build.json" },
    { "path": "../api-headless-cms-pg/tsconfig.build.json" },
    { "path": "../api-headless-cms-sql/tsconfig.build.json" },
    { "path": "../error/tsconfig.build.json" },
    { "path": "../feature/tsconfig.build.json" },
    { "path": "../handler/tsconfig.build.json" },
    { "path": "../shared-aco/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-aco/*": ["../api-aco/src/*"],
      "@webiny/api-aco": ["../api-aco/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-core-sql/*": ["../api-core-sql/src/*"],
      "@webiny/api-core-sql": ["../api-core-sql/src"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/api-headless-cms-pg/*": ["../api-headless-cms-pg/src/*"],
      "@webiny/api-headless-cms-pg": ["../api-headless-cms-pg/src"],
      "@webiny/api-headless-cms-sql/*": ["../api-headless-cms-sql/src/*"],
      "@webiny/api-headless-cms-sql": ["../api-headless-cms-sql/src"],
      "@webiny/error/*": ["../error/src/*"],
      "@webiny/error": ["../error/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/shared-aco/*": ["../shared-aco/src/*"],
      "@webiny/shared-aco": ["../shared-aco/src"]
    }
  }
}
