{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-aco" },
    { "path": "../api-core" },
    { "path": "../api-core-sql" },
    { "path": "../api-headless-cms" },
    { "path": "../api-headless-cms-pg" },
    { "path": "../api-headless-cms-sql" },
    { "path": "../error" },
    { "path": "../feature" },
    { "path": "../handler" },
    { "path": "../project" },
    { "path": "../shared-aco" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-aco/*": ["../api-aco/src/*"],
      "@webiny/api-aco": ["../api-aco/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-core-sql/*": ["../api-core-sql/src/*"],
      "@webiny/api-core-sql": ["../api-core-sql/src"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/api-headless-cms-pg/*": ["../api-headless-cms-pg/src/*"],
      "@webiny/api-headless-cms-pg": ["../api-headless-cms-pg/src"],
      "@webiny/api-headless-cms-sql/*": ["../api-headless-cms-sql/src/*"],
      "@webiny/api-headless-cms-sql": ["../api-headless-cms-sql/src"],
      "@webiny/error/*": ["../error/src/*"],
      "@webiny/error": ["../error/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/project/*": ["../project/src/*"],
      "@webiny/project": ["../project/src"],
      "@webiny/shared-aco/*": ["../shared-aco/src/*"],
      "@webiny/shared-aco": ["../shared-aco/src"]
    }
  }
}
