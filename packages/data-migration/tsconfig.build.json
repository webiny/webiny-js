{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../aws-sdk/tsconfig.build.json" },
    { "path": "../db-dynamodb/tsconfig.build.json" },
    { "path": "../handler-aws/tsconfig.build.json" },
    { "path": "../ioc/tsconfig.build.json" },
    { "path": "../logger/tsconfig.build.json" },
    { "path": "../project/tsconfig.build.json" },
    { "path": "../utils/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/aws-sdk/*": ["../aws-sdk/src/*"],
      "@webiny/aws-sdk": ["../aws-sdk/src"],
      "@webiny/db-dynamodb/*": ["../db-dynamodb/src/*"],
      "@webiny/db-dynamodb": ["../db-dynamodb/src"],
      "@webiny/handler-aws/*": ["../handler-aws/src/*"],
      "@webiny/handler-aws": ["../handler-aws/src"],
      "@webiny/ioc/*": ["../ioc/src/*"],
      "@webiny/ioc": ["../ioc/src"],
      "@webiny/logger/*": ["../logger/src/*"],
      "@webiny/logger": ["../logger/src"],
      "@webiny/project/*": ["../project/src/*"],
      "@webiny/project": ["../project/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"]
    }
  }
}
