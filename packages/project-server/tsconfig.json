{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-headless-cms" },
    { "path": "../cli-core" },
    { "path": "../project" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/cli-core/*": ["../cli-core/src/*"],
      "@webiny/cli-core": ["../cli-core/src"],
      "@webiny/project/*": ["../project/src/*"],
      "@webiny/project": ["../project/src"]
    }
  }
}
