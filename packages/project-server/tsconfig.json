{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-event-handler-server-sql" },
    { "path": "../app" },
    { "path": "../app-serverless-cms" },
    { "path": "../project" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-event-handler-server-sql/*": ["../api-event-handler-server-sql/src/*"],
      "@webiny/api-event-handler-server-sql": ["../api-event-handler-server-sql/src"],
      "@webiny/app/*": ["../app/src/*"],
      "@webiny/app": ["../app/src"],
      "@webiny/app-serverless-cms/*": ["../app-serverless-cms/src/*"],
      "@webiny/app-serverless-cms": ["../app-serverless-cms/src"],
      "@webiny/project/*": ["../project/src/*"],
      "@webiny/project": ["../project/src"]
    }
  }
}
