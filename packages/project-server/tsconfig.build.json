{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../api-event-handler-server-sql/tsconfig.build.json" },
    { "path": "../app/tsconfig.build.json" },
    { "path": "../app-serverless-cms/tsconfig.build.json" },
    { "path": "../project/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-event-handler-server-sql/*": ["../api-event-handler-server-sql/src/*"],
      "@webiny/api-event-handler-server-sql": ["../api-event-handler-server-sql/src"],
      "@webiny/app/*": ["../app/src/*"],
      "@webiny/app": ["../app/src"],
      "@webiny/app-serverless-cms/*": ["../app-serverless-cms/src/*"],
      "@webiny/app-serverless-cms": ["../app-serverless-cms/src"],
      "@webiny/project/*": ["../project/src/*"],
      "@webiny/project": ["../project/src"]
    }
  }
}
