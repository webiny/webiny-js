{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [
    { "path": "../sdk/tsconfig.build.json" },
    { "path": "../theme-common/tsconfig.build.json" }
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/sdk/*": ["../sdk/src/*"],
      "@webiny/sdk": ["../sdk/src"],
      "@webiny/theme-common/*": ["../theme-common/src/*"],
      "@webiny/theme-common": ["../theme-common/src"]
    }
  }
}
