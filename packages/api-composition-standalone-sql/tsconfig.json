{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-composition-core" },
    { "path": "../api-composition-standalone" },
    { "path": "../api-core" },
    { "path": "../api-core-sql" },
    { "path": "../api-mailer" },
    { "path": "../handler" },
    { "path": "../self-hosted-auth" },
    { "path": "../self-hosted-auth-sql" },
    { "path": "../api-aco" },
    { "path": "../api-aco-pg" },
    { "path": "../api-audit-logs" },
    { "path": "../api-graphql" },
    { "path": "../api-headless-cms" },
    { "path": "../api-headless-cms-pg" },
    { "path": "../api-kernel-core" },
    { "path": "../api-storage-pg" },
    { "path": "../api-storage-sqlite" },
    { "path": "../api-websockets" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-composition-core/*": ["../api-composition-core/src/*"],
      "@webiny/api-composition-core": ["../api-composition-core/src"],
      "@webiny/api-composition-standalone/*": ["../api-composition-standalone/src/*"],
      "@webiny/api-composition-standalone": ["../api-composition-standalone/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-core-sql/*": ["../api-core-sql/src/*"],
      "@webiny/api-core-sql": ["../api-core-sql/src"],
      "@webiny/api-mailer/*": ["../api-mailer/src/*"],
      "@webiny/api-mailer": ["../api-mailer/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/self-hosted-auth/*": ["../self-hosted-auth/src/*"],
      "@webiny/self-hosted-auth": ["../self-hosted-auth/src"],
      "@webiny/self-hosted-auth-sql/*": ["../self-hosted-auth-sql/src/*"],
      "@webiny/self-hosted-auth-sql": ["../self-hosted-auth-sql/src"],
      "@webiny/api-aco/*": ["../api-aco/src/*"],
      "@webiny/api-aco": ["../api-aco/src"],
      "@webiny/api-aco-pg/*": ["../api-aco-pg/src/*"],
      "@webiny/api-aco-pg": ["../api-aco-pg/src"],
      "@webiny/api-audit-logs/*": ["../api-audit-logs/src/*"],
      "@webiny/api-audit-logs": ["../api-audit-logs/src"],
      "@webiny/api-graphql/*": ["../api-graphql/src/*"],
      "@webiny/api-graphql": ["../api-graphql/src"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/api-headless-cms-pg/*": ["../api-headless-cms-pg/src/*"],
      "@webiny/api-headless-cms-pg": ["../api-headless-cms-pg/src"],
      "@webiny/api-kernel-core/*": ["../api-kernel-core/src/*"],
      "@webiny/api-kernel-core": ["../api-kernel-core/src"],
      "@webiny/api-storage-pg/*": ["../api-storage-pg/src/*"],
      "@webiny/api-storage-pg": ["../api-storage-pg/src"],
      "@webiny/api-storage-sqlite/*": ["../api-storage-sqlite/src/*"],
      "@webiny/api-storage-sqlite": ["../api-storage-sqlite/src"],
      "@webiny/api-websockets/*": ["../api-websockets/src/*"],
      "@webiny/api-websockets": ["../api-websockets/src"]
    }
  }
}
