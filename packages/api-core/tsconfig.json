{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api" },
    { "path": "../di-container" },
    { "path": "../error" },
    { "path": "../feature" },
    { "path": "../handler" },
    { "path": "../handler-db" },
    { "path": "../handler-graphql" },
    { "path": "../plugins" },
    { "path": "../utils" },
    { "path": "../wcp" },
    { "path": "../api-security-so-ddb" },
    { "path": "../api-tenancy-so-ddb" },
    { "path": "../handler-aws" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api/*": ["../api/src/*"],
      "@webiny/api": ["../api/src"],
      "@webiny/di-container/*": ["../di-container/src/*"],
      "@webiny/di-container": ["../di-container/src"],
      "@webiny/error/*": ["../error/src/*"],
      "@webiny/error": ["../error/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/handler-db/*": ["../handler-db/src/*"],
      "@webiny/handler-db": ["../handler-db/src"],
      "@webiny/handler-graphql/*": ["../handler-graphql/src/*"],
      "@webiny/handler-graphql": ["../handler-graphql/src"],
      "@webiny/plugins/*": ["../plugins/src/*"],
      "@webiny/plugins": ["../plugins/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"],
      "@webiny/wcp/*": ["../wcp/src/*"],
      "@webiny/wcp": ["../wcp/src"],
      "@webiny/api-security-so-ddb/*": ["../api-security-so-ddb/src/*"],
      "@webiny/api-security-so-ddb": ["../api-security-so-ddb/src"],
      "@webiny/api-tenancy-so-ddb/*": ["../api-tenancy-so-ddb/src/*"],
      "@webiny/api-tenancy-so-ddb": ["../api-tenancy-so-ddb/src"],
      "@webiny/handler-aws/*": ["../handler-aws/src/*"],
      "@webiny/handler-aws": ["../handler-aws/src"]
    },
    "baseUrl": "."
  }
}
