{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [{ "path": "../lexical-theme" }, { "path": "../theme-common" }],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/lexical-theme/*": ["../lexical-theme/src/*"],
      "@webiny/lexical-theme": ["../lexical-theme/src"],
      "@webiny/theme-common/*": ["../theme-common/src/*"],
      "@webiny/theme-common": ["../theme-common/src"]
    }
  }
}
