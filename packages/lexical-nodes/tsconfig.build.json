{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [{ "path": "../lexical-theme/tsconfig.build.json" }],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/lexical-theme/*": ["../lexical-theme/src/*"],
      "@webiny/lexical-theme": ["../lexical-theme/src"]
    }
  }
}
