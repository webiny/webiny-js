{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api" },
    { "path": "../api-core" },
    { "path": "../api-graphql" },
    { "path": "../api-headless-cms" },
    { "path": "../api-mailer" },
    { "path": "../api-websockets" },
    { "path": "../background-tasks" },
    { "path": "../feature" },
    { "path": "../utils" },
    { "path": "../api-core-testing" },
    { "path": "../api-headless-cms-testing" },
    { "path": "../plugins" },
    { "path": "../wcp" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api/*": ["../api/src/*"],
      "@webiny/api": ["../api/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-graphql/*": ["../api-graphql/src/*"],
      "@webiny/api-graphql": ["../api-graphql/src"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/api-mailer/*": ["../api-mailer/src/*"],
      "@webiny/api-mailer": ["../api-mailer/src"],
      "@webiny/api-websockets/*": ["../api-websockets/src/*"],
      "@webiny/api-websockets": ["../api-websockets/src"],
      "@webiny/background-tasks/*": ["../background-tasks/src/*"],
      "@webiny/background-tasks": ["../background-tasks/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"],
      "@webiny/api-core-testing/*": ["../api-core-testing/src/*"],
      "@webiny/api-core-testing": ["../api-core-testing/src"],
      "@webiny/api-headless-cms-testing/*": ["../api-headless-cms-testing/src/*"],
      "@webiny/api-headless-cms-testing": ["../api-headless-cms-testing/src"],
      "@webiny/plugins/*": ["../plugins/src/*"],
      "@webiny/plugins": ["../plugins/src"],
      "@webiny/wcp/*": ["../wcp/src/*"],
      "@webiny/wcp": ["../wcp/src"]
    }
  }
}
