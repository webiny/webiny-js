{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../admin-ui" },
    { "path": "../api" },
    { "path": "../api-core" },
    { "path": "../app" },
    { "path": "../app-admin" },
    { "path": "../feature" },
    { "path": "../handler" },
    { "path": "../project" },
    { "path": "../project-aws" },
    { "path": "../app-website-builder" },
    { "path": "../website-builder-sdk" },
    { "path": "../handler-aws" },
    { "path": "../handler-graphql" },
    { "path": "../wcp" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/admin-ui/*": ["../admin-ui/src/*"],
      "@webiny/admin-ui": ["../admin-ui/src"],
      "@webiny/api/*": ["../api/src/*"],
      "@webiny/api": ["../api/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/app/*": ["../app/src/*"],
      "@webiny/app": ["../app/src"],
      "@webiny/app-admin/*": ["../app-admin/src/*"],
      "@webiny/app-admin": ["../app-admin/src"],
      "@webiny/feature/api": ["../feature/src/api/index.js"],
      "@webiny/feature/admin": ["../feature/src/admin/index.js"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/handler/*": ["../handler/src/*"],
      "@webiny/handler": ["../handler/src"],
      "@webiny/project/*": ["../project/src/*"],
      "@webiny/project": ["../project/src"],
      "@webiny/project-aws/*": ["../project-aws/src/*"],
      "@webiny/project-aws": ["../project-aws/src"],
      "@webiny/app-website-builder/*": ["../app-website-builder/src/*"],
      "@webiny/app-website-builder": ["../app-website-builder/src"],
      "@webiny/website-builder-sdk/*": ["../website-builder-sdk/src/*"],
      "@webiny/website-builder-sdk": ["../website-builder-sdk/src"],
      "@webiny/handler-aws/*": ["../handler-aws/src/*"],
      "@webiny/handler-aws": ["../handler-aws/src"],
      "@webiny/handler-graphql/*": ["../handler-graphql/src/*"],
      "@webiny/handler-graphql": ["../handler-graphql/src"],
      "@webiny/wcp/*": ["../wcp/src/*"],
      "@webiny/wcp": ["../wcp/src"]
    }
  }
}
