{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../api-core" },
    { "path": "../api-headless-cms" },
    { "path": "../api-headless-cms-ddb-es" },
    { "path": "../api-headless-cms-utils-os" },
    { "path": "../api-opensearch" },
    { "path": "../background-tasks" },
    { "path": "../feature" },
    { "path": "../utils" },
    { "path": "../api-graphql" },
    { "path": "../api-headless-cms-testing" },
    { "path": "../db-dynamodb" },
    { "path": "../wcp" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/api-headless-cms-ddb-es/*": ["../api-headless-cms-ddb-es/src/*"],
      "@webiny/api-headless-cms-ddb-es": ["../api-headless-cms-ddb-es/src"],
      "@webiny/api-headless-cms-utils-os/*": ["../api-headless-cms-utils-os/src/*"],
      "@webiny/api-headless-cms-utils-os": ["../api-headless-cms-utils-os/src"],
      "@webiny/api-opensearch/*": ["../api-opensearch/src/*"],
      "@webiny/api-opensearch": ["../api-opensearch/src"],
      "@webiny/background-tasks/*": ["../background-tasks/src/*"],
      "@webiny/background-tasks": ["../background-tasks/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/utils/*": ["../utils/src/*"],
      "@webiny/utils": ["../utils/src"],
      "@webiny/api-graphql/*": ["../api-graphql/src/*"],
      "@webiny/api-graphql": ["../api-graphql/src"],
      "@webiny/api-headless-cms-testing/*": ["../api-headless-cms-testing/src/*"],
      "@webiny/api-headless-cms-testing": ["../api-headless-cms-testing/src"],
      "@webiny/db-dynamodb/*": ["../db-dynamodb/src/*"],
      "@webiny/db-dynamodb": ["../db-dynamodb/src"],
      "@webiny/wcp/*": ["../wcp/src/*"],
      "@webiny/wcp": ["../wcp/src"]
    }
  }
}
