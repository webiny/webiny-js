    "Webiny Team"
  ],
  "license": "MIT",
  "dependencies": {
    "@webiny/api-aco-sql": "0.0.0",
    "@webiny/api-audit-logs-sql": "0.0.0",
    "@webiny/api-core-sql": "0.0.0",
    "@webiny/api-event-handler-server": "0.0.0",
    "@webiny/api-headless-cms-sql": "0.0.0",
    "@webiny/api-websockets-sql": "0.0.0",
    "@webiny/handler": "0.0.0",
    "@webiny/self-hosted-auth": "0.0.0",
    "@webiny/self-hosted-auth-sql": "0.0.0",
