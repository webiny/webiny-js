{
  "extends": "../../tsconfig.build.json",
  "include": ["src"],
  "references": [{ "path": "../api/tsconfig.build.json" }, { "path": "../db/tsconfig.build.json" }],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/api/*": ["../api/src/*"],
      "@webiny/api": ["../api/src"],
      "@webiny/db/*": ["../db/src/*"],
      "@webiny/db": ["../db/src"]
    },
    "baseUrl": "."
  }
}
