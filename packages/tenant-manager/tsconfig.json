{
  "extends": "../../tsconfig.json",
  "include": ["src", "__tests__"],
  "references": [
    { "path": "../admin-ui" },
    { "path": "../api-core" },
    { "path": "../api-graphql" },
    { "path": "../api-headless-cms" },
    { "path": "../app" },
    { "path": "../app-aco" },
    { "path": "../app-admin" },
    { "path": "../app-headless-cms" },
    { "path": "../feature" },
    { "path": "../project" },
    { "path": "../project-aws" },
    { "path": "../api-headless-cms-testing" }
  ],
  "compilerOptions": {
    "rootDirs": ["./src", "./__tests__"],
    "outDir": "./dist",
    "declarationDir": "./dist",
    "paths": {
      "~/*": ["./src/*"],
      "~tests/*": ["./__tests__/*"],
      "@webiny/admin-ui/*": ["../admin-ui/src/*"],
      "@webiny/admin-ui": ["../admin-ui/src"],
      "@webiny/api-core/*": ["../api-core/src/*"],
      "@webiny/api-core": ["../api-core/src"],
      "@webiny/api-graphql/*": ["../api-graphql/src/*"],
      "@webiny/api-graphql": ["../api-graphql/src"],
      "@webiny/api-headless-cms/*": ["../api-headless-cms/src/*"],
      "@webiny/api-headless-cms": ["../api-headless-cms/src"],
      "@webiny/app/*": ["../app/src/*"],
      "@webiny/app": ["../app/src"],
      "@webiny/app-aco/*": ["../app-aco/src/*"],
      "@webiny/app-aco": ["../app-aco/src"],
      "@webiny/app-admin/*": ["../app-admin/src/*"],
      "@webiny/app-admin": ["../app-admin/src"],
      "@webiny/app-headless-cms/*": ["../app-headless-cms/src/*"],
      "@webiny/app-headless-cms": ["../app-headless-cms/src"],
      "@webiny/feature/*": ["../feature/src/*"],
      "@webiny/feature": ["../feature/src"],
      "@webiny/project/*": ["../project/src/*"],
      "@webiny/project": ["../project/src"],
      "@webiny/project-aws/*": ["../project-aws/src/*"],
      "@webiny/project-aws": ["../project-aws/src"],
      "@webiny/api-headless-cms-testing/*": ["../api-headless-cms-testing/src/*"],
      "@webiny/api-headless-cms-testing": ["../api-headless-cms-testing/src"]
    }
  }
}
