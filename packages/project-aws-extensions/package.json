{
  "name": "@webiny/project-aws-extensions",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./*": "./*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webiny/webiny-js.git"
  },
  "description": "Extension definitions and abstractions for AWS Webiny projects, without the AWS or Pulumi code that implements them.",
  "license": "MIT",
  "dependencies": {
    "@webiny/project": "0.0.0",
    "react": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@webiny/build-tools": "0.0.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "webiny": {
    "publishFrom": "dist"
  }
}
